{
  "uid": "fc-technical",
  "title": "Технические логи",
  "description": "Мониторинг FunAndChecks. Доступ через актуальную роль суперадминистратора приложения.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "FunAndChecks"
  ],
  "links": [
    {
      "title": "Нагрузка",
      "url": "/metrics/d/fc-load/load",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "Технические логи",
      "url": "/metrics/d/fc-technical/technical",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "Действия администраторов",
      "url": "/metrics/d/fc-audit/audit",
      "type": "link",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
