    {
      "id": 1,
      "title": "Запросов в секунду",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "funandchecks-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(funandchecks_http_requests_total{job=\"funandchecks-api\"}[1m]))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "funandchecks-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
