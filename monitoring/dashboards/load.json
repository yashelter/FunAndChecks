{
  "uid": "fc-load",
  "title": "Нагрузка",
  "description": "Мониторинг FunAndChecks. Доступ через актуальную роль суперадминистратора приложения.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
