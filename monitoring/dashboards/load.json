      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route,method) (rate(funandchecks_http_requests_total{job=\"funandchecks-api\"}[1m]))",
          "legendFormat": "{{method}} {{route}}",
          "datasource": {
