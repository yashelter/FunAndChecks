@implements IDisposable
@inject IStringLocalizer<AppStrings> Loc

@* Рисуется через SeasonalDecorations, только пока тема WinterTheme активна.
   Всё в оверлее поверх страницы; клики проходят насквозь, кроме лампочек гирлянды и снеговика. *@
