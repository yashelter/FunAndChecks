                <path class="fc-wt-sparkle" d="M92 22 L100 22 M94 18.5 L98 25.5 M98 18.5 L94 25.5 M36.5 92 L43.5 92 M38.2 89 L41.8 95 M41.8 89 L38.2 95 M109 70 L115 70 M110.5 67.4 L113.5 72.6 M113.5 67.4 L110.5 72.6" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
            </symbol>
            <radialGradient id="fc-wt-snow-fill" cx="38%" cy="32%" r="70%">
                <stop offset="0%" stop-color="#ffffff" /><stop offset="70%" stop-color="#eef4fc" /><stop offset="100%" stop-color="#c9d8ec" />
            </radialGradient>
        </defs>
    </svg>

    @* Иней в верхних углах: статичен, виден на любом экране и при «меньше движения». *@
    <svg class="fc-wt-frost fc-wt-frost-left" aria-hidden="true" focusable="false"><use href="#fc-wt-frost-symbol" /></svg>
    <svg class="fc-wt-frost fc-wt-frost-right" aria-hidden="true" focusable="false"><use href="#fc-wt-frost-symbol" /></svg>

    @* Снегопад: внешний слой падает, внутренний покачивается; отрицательные задержки — снег идёт сразу. *@
    <div class="fc-wt-snow" aria-hidden="true">
        @foreach (var flake in Flakes)
        {
            <div class="fc-wt-flake" style="@FlakeStyle(flake)"><div class="fc-wt-flake-sway">@FlakeShape(flake)</div></div>
        }
    </div>

    @* Метель от снеговика: отдельная пачка снежинок, летит быстрее и наискосок, через несколько секунд убирается. *@
    @if (_blizzardKey is not null)
    {
        <div class="fc-wt-blizzard" @key="_blizzardKey" aria-hidden="true">
            @foreach (var flake in Gusts)
            {
                <div class="fc-wt-flake fc-wt-gust" style="@FlakeStyle(flake)"><div class="fc-wt-flake-sway">@FlakeShape(flake)</div></div>
            }
        </div>
    }

    @* Гирлянда: провод провисает четырьмя дугами, лампочки висят на нём. Кликабельны только лампочки —
       кнопки шапки под проводом остаются доступны. Клик переключает режим мигания. *@
    <button type="button" class="fc-wt-garland fc-wt-garland-@GarlandMode" aria-label="@GarlandTitle" title="@GarlandTitle" @onclick="NextGarlandMode">
        <svg class="fc-wt-wire" viewBox="0 0 1000 30" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path d="M0 2 Q125 22 250 2 Q375 22 500 2 Q625 22 750 2 Q875 22 1000 2" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
        <span class="fc-wt-bulbs" aria-hidden="true">
            @foreach (var bulb in Bulbs)
            {
                <span class="fc-wt-bulb" style="--x:@Css(bulb.X)%;--y:@Css(bulb.Y)px;--i:@bulb.Index;--tw:@Css(bulb.Twinkle)s"></span>
            }
        </span>
    </button>

    @* Сугробы в нижних углах; полосы во всю ширину нет, чтобы не закрывать низ страницы. *@
    <svg class="fc-wt-drift fc-wt-drift-left" viewBox="0 0 260 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 44 L0 14 Q34 2 78 12 Q124 22 168 20 Q214 18 260 40 L260 44 Z" fill="var(--fc-winter-drift)" />
        <path d="M0 14 Q34 2 78 12 Q124 22 168 20 Q214 18 260 40" fill="none" stroke="var(--fc-winter-drift-edge)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>
    <svg class="fc-wt-drift fc-wt-drift-right" viewBox="0 0 260 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 44 L0 14 Q34 2 78 12 Q124 22 168 20 Q214 18 260 40 L260 44 Z" fill="var(--fc-winter-drift)" />
        <path d="M0 14 Q34 2 78 12 Q124 22 168 20 Q214 18 260 40" fill="none" stroke="var(--fc-winter-drift-edge)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </svg>

    @* Снеговик в правом нижнем углу: изредка покачивается, шарф развевается; по клику — метель. *@
    <button type="button" class="fc-wt-snowman" aria-label="@Loc["Winter_SnowmanLabel"]" title="@Loc["Winter_SnowmanLabel"]" @onclick="StartBlizzard">
        <svg class="@(_blizzardKey is null ? null : "fc-wt-snowman-shake")" @key="@(_blizzardKey ?? "idle")" viewBox="0 0 64 72" aria-hidden="true" focusable="false">
            <g stroke="var(--fc-winter-snowman-edge)" stroke-width="1.2" fill="url(#fc-wt-snow-fill)">
                <circle cx="32" cy="55" r="16" />
                <circle cx="32" cy="33" r="12" />
                <circle cx="32" cy="16" r="9" />
            </g>
            <path d="M21 11 L43 11 L40 2.5 Q32 0.5 24 2.5 Z" fill="#5d6f86" />
            <path d="M19.5 11 L44.5 11" stroke="#46566b" stroke-width="2.4" stroke-linecap="round" />
            <circle cx="28.5" cy="15" r="1.4" fill="#1d2430" />
            <circle cx="35.5" cy="15" r="1.4" fill="#1d2430" />
            <path d="M32 17.5 L41 19.4 L32 20.3 Z" fill="#f08a24" />
            <circle cx="32" cy="30" r="1.3" fill="#1d2430" />
            <circle cx="32" cy="35" r="1.3" fill="#1d2430" />
            <circle cx="32" cy="50" r="1.4" fill="#1d2430" />
            <path d="M22.5 24 Q32 27.5 41.5 24 L41.5 27.5 Q32 31 22.5 27.5 Z" fill="#d6334a" />
            <path class="fc-wt-scarf-tail" d="M37 26.5 L41 26 L43 37 L39 37.5 Z" fill="#c22a40" />
            <path d="M21 31 L11 25 M14 26.8 L12.5 23 M44 31 L53 24.5 M50 26.6 L51.5 22.6" stroke="#6b4a2e" stroke-width="1.6" stroke-linecap="round" fill="none" />
        </svg>
    </button>
</div>

@code {
    /// <summary>Режимы гирлянды по кругу: класс <c>fc-wt-garland-{режим}</c> и строка <c>Winter_GarlandMode_{режим}</c>.</summary>
    private static readonly string[] GarlandModes = ["chase", "twinkle", "rainbow", "steady"];

    private readonly record struct Flake(double X, double Size, double Fall, double Delay, double Opacity, double Sway, double Drift);
    private readonly record struct Bulb(int Index, double X, double Y, double Twinkle);

    /// <summary>Обычный снегопад. Случайность с постоянным зерном: картинка одна и та же, а в разметке нет «магических» таблиц.</summary>
    private static readonly Flake[] Flakes = MakeFlakes(28, seed: 2026, gust: false);

    /// <summary>Метель: густая пачка быстрых снежинок по диагонали, разово; поверх — лёгкая пелена (CSS).</summary>
    private static readonly Flake[] Gusts = MakeFlakes(64, seed: 1231, gust: true);

    /// <summary>
    /// 24 лампочки: по 6 на каждую из 4 дуг провода. Дуга — квадратичная кривая с вершиной 22 из 30 по высоте:
    /// y = 2 + 40·t·(1 − t), x растёт линейно, поэтому лампочка точно висит на проводе.
    /// </summary>
    private static readonly Bulb[] Bulbs = MakeBulbs();

    /// <summary>Сколько держится метель и как часто её можно запускать.</summary>
    private const int BlizzardMs = 6000;
    private static readonly TimeSpan BlizzardCooldown = TimeSpan.FromSeconds(4);

    private Timer? _blizzardTimer;
    private string? _blizzardKey;
    private DateTime _lastBlizzard = DateTime.MinValue;
    private int _garlandMode;

    private string GarlandMode => GarlandModes[_garlandMode];
    private string GarlandTitle => $"{Loc["Winter_GarlandLabel"]}: {Loc["Winter_GarlandMode_" + GarlandMode]}";

    /// <summary>Числа в inline-стилях — с точкой при любой культуре интерфейса.</summary>
    private static string Css(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string FlakeStyle(Flake f) =>
        $"--x:{Css(f.X)}%;--size:{Css(f.Size)}px;--fall:{Css(f.Fall)}s;--delay:{Css(f.Delay)}s;--o:{Css(f.Opacity)};--sway:{Css(f.Sway)}px;--drift:{Css(f.Drift)}vw";

    /// <summary>Мелкие снежинки — точки, крупные — шестилучевые.</summary>
    private static RenderFragment FlakeShape(Flake f) => f.Size >= 9
        ? @<svg focusable="false"><use href="#fc-wt-flake-symbol" /></svg>
        : @<span class="fc-wt-dot"></span>;

    private static Flake[] MakeFlakes(int count, int seed, bool gust)
    {
        var random = new Random(seed);
        double Between(double min, double max) => min + random.NextDouble() * (max - min);
        return Enumerable.Range(0, count).Select(i => gust
            ? new Flake(Between(10, 130), Between(4, 11), Between(1.8, 3.2), Between(0, 2.4), Between(.6, .95), Between(4, 10), -Between(25, 45))
            : new Flake((i + Between(.1, .9)) * 100.0 / count, Between(4, 12), Between(9, 18), -Between(0, 18), Between(.5, .85), Between(8, 22), 0))
            .ToArray();
    }

    private static Bulb[] MakeBulbs()
    {
        var random = new Random(24);
        return Enumerable.Range(0, 24).Select(i =>
        {
            var swag = i / 6;
            var t = (i % 6 + 0.5) / 6;
            return new Bulb(i, (swag + t) * 25, 2 + 40 * t * (1 - t), random.NextDouble() * 2.4);
        }).ToArray();
    }

    /// <summary>Пасхалка: клик по лампочке переключает режим гирлянды.</summary>
    private void NextGarlandMode() => _garlandMode = (_garlandMode + 1) % GarlandModes.Length;

    /// <summary>Пасхалка: снеговик устраивает метель на несколько секунд (не чаще раза в 4 секунды).</summary>
    private void StartBlizzard()
    {
        if (DateTime.UtcNow - _lastBlizzard < BlizzardCooldown) return;
        _lastBlizzard = DateTime.UtcNow;
        _blizzardKey = Guid.NewGuid().ToString();
        _blizzardTimer ??= new Timer(_ => InvokeAsync(EndBlizzard), null, Timeout.Infinite, Timeout.Infinite);
        _blizzardTimer.Change(BlizzardMs, Timeout.Infinite);
    }

    private void EndBlizzard()
    {
        _blizzardKey = null;
        StateHasChanged();
    }

    public void Dispose() => _blizzardTimer?.Dispose();
}
