@namespace Frontend.Shared.UI
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav

@* Сворачиваемый раздел бокового меню (преподаватель и студент). Состояние хранится в localStorage; переход на страницу
   раздела раскрывает его. Свёрнутый раздел с непрочитанным (.fc-nav-badge внутри) показывает точку у заголовка — dashboard.css. *@
<div class="fc-nav-section @(_expanded ? "is-open" : "is-collapsed") @(_ready ? "is-ready" : "")">
    <button type="button" class="fc-nav-section-head" aria-expanded="@(_expanded ? "true" : "false")" aria-controls="@BodyId"
            @onclick="ToggleAsync" @onclick:stopPropagation="true">
        <MudIcon Icon="@Icon" Size="Size.Small" Class="fc-nav-section-icon" />
        <span class="fc-nav-section-title">@Title</span>
        <span class="fc-nav-section-dot" aria-hidden="true"></span>
        <MudIcon Icon="@Icons.Material.Outlined.ExpandMore" Size="Size.Small" Class="fc-nav-section-chevron" />
    </button>
    <div id="@BodyId" class="fc-nav-section-body" inert="@(!_expanded)">
        <div class="fc-nav-section-inner">@ChildContent</div>
    </div>
</div>

@code {
    /// <summary>Ключ для запоминания состояния (localStorage).</summary>
    [Parameter, EditorRequired] public string Key { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Folder;
    /// <summary>Начала адресов страниц раздела: на них раздел раскрывается сам.</summary>
    [Parameter] public string[] Paths { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _expanded = true;
    // Анимация включается после чтения сохранённого состояния: иначе свёрнутый раздел «схлопывался» бы при каждой загрузке.
    private bool _ready;
    private string StorageKey => $"fc-nav-collapsed:{Key}";
    private string BodyId => $"fc-nav-section-{Key}";

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var collapsed = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey) == "1";
            _expanded = !collapsed || IsCurrentPath(Nav.Uri);
        }
        catch (JSException) { }
        _ready = true;
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        _expanded = !_expanded;
        try
        {
            if (_expanded) await JS.InvokeVoidAsync("localStorage.removeItem", StorageKey);
            else await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, "1");
        }
        catch (JSException) { }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (_expanded || !IsCurrentPath(args.Location)) return;
        _expanded = true;
        InvokeAsync(StateHasChanged);
    }

    private bool IsCurrentPath(string uri)
    {
        var path = Nav.ToAbsoluteUri(uri).AbsolutePath;
        return Paths.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
