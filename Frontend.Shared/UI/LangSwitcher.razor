@inject CultureService CultureSvc
@inject UnsavedChangesTracker Dirty
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> Loc
@inject AuthenticationStateProvider AuthState
@inject MeApi Me

@* Выбор языка — секция панели «Интерфейс» (AppearanceSettings). Названия языков пишутся на самих языках. *@
<div class="fc-language-options" role="group" aria-label="Language / Язык">
    @foreach (var (culture, langCode, name) in Languages)
    {
        var active = CultureSvc.CurrentCulture == culture;
        <button type="button" class="fc-language-option @(active ? "active" : "")" aria-pressed="@(active ? "true" : "false")" lang="@langCode"
                @onclick="@(() => ChangeAsync(culture))">
            <span class="fc-language-code" aria-hidden="true">@langCode.ToUpperInvariant()</span>@name
            @if (active) { <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" Class="fc-language-check" /> }
        </button>
    }
</div>

@code {
    private static readonly (string Culture, string Code, string Name)[] Languages =
        [("ru-RU", "ru", "Русский"), ("en-US", "en", "English")];

    private async Task ChangeAsync(string culture)
    {
        if (culture == CultureSvc.CurrentCulture)
            return;

        if (Dirty.IsDirty)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                Loc["Culture_UnsavedTitle"], Loc["Culture_UnsavedMessage"],
                yesText: Loc["Common_Yes"], cancelText: Loc["Common_Cancel"]);
            if (confirmed != true)
                return;
        }

        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (state.User.Identity?.IsAuthenticated == true)
                await Me.SetPreferredCultureAsync(culture);
        }
        catch (ApiException ex)
        {
            // Выбор не сохранился в аккаунте: после перезагрузки синхронизация культуры
            // молча откатила бы язык обратно — сообщаем об ошибке и не переключаем.
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        Dirty.ClearAll();
        await CultureSvc.SetCultureAsync(culture);
    }
}
