@implements IDisposable
@inject DashboardAppearanceService Appearance
@inject FeatureFlagsService Flags
@inject IStringLocalizer<AppStrings> Loc

@if (Flags.HalloweenEvent && Appearance.IsHalloweenMode)
{
    <div class="fc-halloween-animations" role="img" aria-label="@Loc["Halloween_AriaLabel"]">
        @* Один раз определённые символы — потом переиспользуются через <use>. *@
        <svg class="fc-halloween-defs" aria-hidden="true" focusable="false" width="0" height="0">
            <defs>
                <symbol id="fc-halloween-ghost-symbol" viewBox="0 0 64 64">
                    <path d="M32 4 C16.5 4 4 18.5 4 34 L4 52 C4 56 7 59 11 59 L16 59 C16 62 18 64 21 64 L43 64 C46 64 48 62 48 59 L53 59 C57 59 60 56 60 52 L60 34 C60 18.5 47.5 4 32 4 Z" fill="currentColor" opacity="0.92" />
                    <ellipse cx="22" cy="28" rx="5" ry="6" fill="#2d1a0e" />
                    <ellipse cx="20" cy="26" rx="1.5" ry="1.5" fill="#fff" opacity="0.85" />
                    <ellipse cx="42" cy="28" rx="5" ry="6" fill="#2d1a0e" />
                    <ellipse cx="40" cy="26" rx="1.5" ry="1.5" fill="#fff" opacity="0.85" />
                    <ellipse cx="32" cy="38" rx="3" ry="2" fill="#2d1a0e" />
                    <ellipse cx="14" cy="36" rx="4" ry="2.5" fill="#ff8fa3" opacity="0.55" />
                    <ellipse cx="50" cy="36" rx="4" ry="2.5" fill="#ff8fa3" opacity="0.55" />
                </symbol>
                <symbol id="fc-halloween-spider-symbol" viewBox="0 0 64 64">
                    <ellipse cx="32" cy="42" rx="14" ry="16" fill="currentColor" opacity="0.95" />
                    <ellipse cx="32" cy="26" rx="10" ry="9" fill="currentColor" opacity="0.95" />
                    <ellipse cx="26" cy="23" rx="4.5" ry="5" fill="#fff" />
                    <ellipse cx="26" cy="22" rx="2" ry="2.5" fill="#1a0d05" />
                    <ellipse cx="24" cy="21" rx="1" ry="1" fill="#fff" opacity="0.9" />
                    <ellipse cx="38" cy="23" rx="4.5" ry="5" fill="#fff" />
                    <ellipse cx="38" cy="22" rx="2" ry="2.5" fill="#1a0d05" />
                    <ellipse cx="36" cy="21" rx="1" ry="1" fill="#fff" opacity="0.9" />
                    <g stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" opacity="0.9">
                        <path d="M18 22 Q8 18 4 22 Q0 26 4 30" />
                        <path d="M16 30 Q6 28 2 34 Q-1 40 3 44" />
                        <path d="M16 38 Q6 40 2 48 Q-1 54 4 58" />
                        <path d="M18 46 Q10 52 8 58 Q6 62 12 62" />
                        <path d="M46 22 Q56 18 60 22 Q64 26 60 30" />
                        <path d="M48 30 Q58 28 62 34 Q65 40 61 44" />
                        <path d="M48 38 Q58 40 62 48 Q65 54 60 58" />
                        <path d="M46 46 Q54 52 56 58 Q58 62 52 62" />
                    </g>
                </symbol>
            </defs>
        </svg>

        @* Пять «теневых» призраков, каждый со своей траекторией через весь экран. *@
        @foreach (var ghost in Ghosts)
        {
            <div class="fc-halloween-ghost @ghost" aria-hidden="true">
                <svg class="fc-ghost-svg" preserveAspectRatio="xMidYMid meet"><use href="#fc-halloween-ghost-symbol" /></svg>
            </div>
        }

        @* Паук: выходит из-за верхнего края, спускается, задерживается и поднимается обратно.
           Смена @key пересоздаёт элемент и перезапускает CSS-анимацию. *@
        <div class="fc-halloween-spider" aria-hidden="true" @key="_spiderKey" style="--spider-x:@_spiderX">
            <svg class="fc-spider-svg" preserveAspectRatio="xMidYMid meet"><use href="#fc-halloween-spider-symbol" /></svg>
        </div>
    </div>
}

@code {
    /// <summary>Классы призраков — у каждого своя траектория и свой цикл.</summary>
    private static readonly string[] Ghosts =
    [
        "fc-halloween-ghost-1", "fc-halloween-ghost-2", "fc-halloween-ghost-3",
        "fc-halloween-ghost-4", "fc-halloween-ghost-5"
    ];

    private Timer? _spiderTimer;
    private string _spiderKey = Guid.NewGuid().ToString();
    private string _spiderX = "50%";

    protected override void OnInitialized()
    {
        Appearance.Changed += OnAppearanceChanged;
        StartSpiderTimer();
    }

    private void OnAppearanceChanged()
    {
        InvokeAsync(() =>
        {
            if (Flags.HalloweenEvent && Appearance.IsHalloweenMode) StartSpiderTimer();
            else StopSpiderTimer();
            StateHasChanged();
        });
    }

    private void StartSpiderTimer()
    {
        StopSpiderTimer();
        var random = new Random();
        var initialDelay = random.Next(3000, 10000);
        _spiderX = $"{random.Next(15, 85)}%";
        _spiderTimer = new Timer(_ => TriggerSpider(), null, initialDelay, 20000);
    }

    private void StopSpiderTimer()
    {
        _spiderTimer?.Dispose();
        _spiderTimer = null;
    }

    private void TriggerSpider()
    {
        InvokeAsync(() =>
        {
            _spiderKey = Guid.NewGuid().ToString();
            _spiderX = $"{new Random().Next(15, 85)}%";
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Appearance.Changed -= OnAppearanceChanged;
        StopSpiderTimer();
    }
}
