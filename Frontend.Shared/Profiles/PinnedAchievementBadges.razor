@namespace Frontend.Shared.Profiles
@inject IDialogService Dialogs

@if (Items is { Count: > 0 })
{
    <span class="fc-pinned-achievement-badges" aria-label="@ProfileText.T("Закреплённые достижения", "Pinned achievements")">
        @foreach (var achievement in Items.OrderBy(x => x.Position))
        {
            <button @key="achievement.AwardId" type="button" class="fc-pinned-achievement-badge" title="@achievement.Name"
                    aria-label="@achievement.Name" @onclick="() => OpenAsync(achievement)">
                <ProfileMedia Media="@achievement.Image" Alt="@achievement.Name" Class="fc-pinned-achievement-image" />
            </button>
        }
    </span>
}

@code {
    [Parameter] public IReadOnlyList<PinnedAchievementBadgeDto>? Achievements { get; set; }
    [Parameter] public IReadOnlyList<AchievementAwardDto>? AwardItems { get; set; }
    [Parameter] public string BasePath { get; set; } = "/student";

    private IReadOnlyList<PinnedAchievementBadgeDto>? Items =>
        Achievements ?? AwardItems?
            .Where(x => x.PinPosition.HasValue)
            .OrderBy(x => x.PinPosition)
            .Select(x => new PinnedAchievementBadgeDto(x.Id, x.AchievementId, x.Name, x.Image, x.PinPosition!.Value))
            .ToList();
    private async Task OpenAsync(PinnedAchievementBadgeDto achievement)
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        await Dialogs.ShowAsync<AchievementBadgeDialog>(
            achievement.Name,
            new DialogParameters { [nameof(AchievementBadgeDialog.Achievement)] = achievement },
            options);
    }
}
