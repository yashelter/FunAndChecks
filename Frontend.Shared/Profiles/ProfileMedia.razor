@namespace Frontend.Shared.Profiles
@implements IAsyncDisposable
@inject ProfileMediaCache Cache
@inject IJSRuntime JS

@* Без loading="lazy": загрузку и так ведёт IntersectionObserver, а ленивые картинки в прокручиваемых
   контейнерах и липких колонках Chrome иногда не грузит вовсе — аватар оставался пустым. *@
<span @ref="_element" class="fc-profile-media @Class" role="img" aria-label="@Alt">
    @if (_url is not null)
    {
        @if (Media?.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true)
        {
            <video src="@_url" poster="@_poster" muted loop autoplay playsinline aria-hidden="true" @onerror="MediaFailedAsync"></video>
        }
        else { <img src="@_url" alt="@Alt" @onerror="MediaFailedAsync" /> }
    }
    else { <span class="fc-profile-initials">@Fallback</span> }
</span>

@code {
    [Parameter] public MediaDto? Media { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string Fallback { get; set; } = "◇";
    [Parameter] public string Class { get; set; } = "";
    private ElementReference _element;
    private IJSObjectReference? _module;
    private string? _url, _poster;
    private MediaBlobLease? _blob, _posterBlob;
    private Guid? _loaded;
    private bool _observe;
    private bool _disposed, _registered;
    private bool _visible;
    private Guid? _expected, _loadingId;
    private int _generation;
    private DotNetObjectReference<ProfileMedia>? _reference;
    private readonly CancellationTokenSource _life = new();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Аватар — украшение: если модуль не загрузился или устарел, остаются инициалы, а не ошибка всей страницы.
        try { await AfterRenderAsync(); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    private async Task AfterRenderAsync()
    {
        if (_disposed) return;
        var module = _module ?? await JS.InvokeAsync<IJSObjectReference>("import", ProfileMediaModule.Url);
        if (_disposed) { await module.DisposeAsync(); return; }
        _module = module;
        if (Media is not null && !_registered)
        {
            _reference ??= DotNetObjectReference.Create(this);
            _registered = true;
            await module.InvokeVoidAsync("observeMedia", _element, _reference);
            if (_disposed) return;
        }
        if (_observe)
        {
            _observe = false;
            await module.InvokeVoidAsync("refreshMedia", _element, _poster, _url);
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (Media?.Id == _expected) return;
        _expected = Media?.Id; _generation++;
        _registered = false;
        await ReleaseAsync();
    }
    protected override void OnInitialized() => Cache.Cleared += CacheCleared;

    // Кеш отозвал все blob-адреса: показанный адрес мёртв — сбрасываем и, если видны, грузим заново.
    private void CacheCleared() => InvokeAsync(async () =>
    {
        if (_disposed) return;
        await ReleaseAsync();
        if (_visible) await VisibleAsync();
        StateHasChanged();
    });

    /// <summary>Картинка или видео не загрузились — показываем инициалы; при следующем появлении на экране попробуем снова.</summary>
    private async Task MediaFailedAsync()
    {
        if (_disposed) return;
        await ReleaseAsync();
    }

    [JSInvokable] public async Task VisibilityChangedAsync(bool visible)
    {
        if (_disposed) return;
        _visible = visible;
        if (visible) await VisibleAsync();
        else { await ReleaseAsync(); if (!_disposed) await InvokeAsync(StateHasChanged); }
    }
    private async Task VisibleAsync()
    {
        if (_disposed || Media is null || Media.Id == _loaded || Media.Id == _loadingId) return;
        var media = Media; var generation = _generation; _loadingId = media.Id;
        MediaBlobLease? blob = null, poster = null;
        try
        {
            blob = await Cache.AcquireAsync(media, false);
            if (media.HasPoster) poster = await Cache.AcquireAsync(media, true);
            if (_disposed || !_visible || generation != _generation) { await blob.DisposeAsync(); if (poster is not null) await poster.DisposeAsync(); return; }
            _loaded = media.Id; _blob = blob; _posterBlob = poster; _url = blob.Url; _poster = poster?.Url;
            _observe = true; await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is ApiException or JSException or OperationCanceledException) { if (blob is not null) await blob.DisposeAsync(); if (poster is not null) await poster.DisposeAsync(); }
        finally { if (_loadingId == media.Id) _loadingId = null; }
    }
    private async Task ReleaseAsync()
    {
        var blob = _blob; var poster = _posterBlob;
        _blob = _posterBlob = null;
        _url = _poster = null;
        _loaded = null;
        _observe = true;
        if (blob is not null) await blob.DisposeAsync(); if (poster is not null) await poster.DisposeAsync();
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _life.Cancel();
        // Компонент может быть создан без DI (тесты) — тогда подписки не было.
        if (Cache is not null) Cache.Cleared -= CacheCleared;
        try { if (_module is not null) { await _module.InvokeVoidAsync("unobserve", _element); await ReleaseAsync(); await _module.DisposeAsync(); } }
        catch (JSException) { }
        _life.Dispose();
        _reference?.Dispose();
    }
}
