@page "/register"
@layout AuthLayout

<PageTitle>@Loc["Register_PageTitle"]</PageTitle>

<section class="fc-auth-card">
    <AuthIntro />
    <div class="fc-auth-form">
    <MudText Typo="Typo.h5">@Loc["Register_Title"]</MudText>

    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <Frontend.Shared.Components.ServerValidator @ref="_serverValidator" />
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField For="@(() => _model.FirstName)" @bind-Value="_model.FirstName" Label="@Loc["Register_FirstNameLabel"]" Required="true" RequiredError="@Loc["Register_FirstNameRequired"]" Variant="Variant.Outlined" autocomplete="given-name" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField For="@(() => _model.LastName)" @bind-Value="_model.LastName" Label="@Loc["Register_LastNameLabel"]" Required="true" RequiredError="@Loc["Register_LastNameRequired"]" Variant="Variant.Outlined" autocomplete="family-name" />
            </MudItem>
        </MudGrid>

        <MudTextField For="@(() => _model.Email)" @bind-Value="_model.Email" Label="@Loc["Common_EmailLabel"]" InputType="InputType.Email"
                      Required="true" RequiredError="@Loc["Common_EmailRequired"]" Variant="Variant.Outlined" autocomplete="email" />

        <MudTextField For="@(() => _model.Password)" @bind-Value="_model.Password" Label="@Loc["Register_PasswordLabel"]"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Required="true" RequiredError="@Loc["Common_PasswordRequired"]" Variant="Variant.Outlined" autocomplete="new-password"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showPassword = !_showPassword)" AdornmentAriaLabel="@Loc["Register_ShowPassword"]" />

        <MudTextField For="@(() => _model.ConfirmPassword)" @bind-Value="_model.ConfirmPassword" Label="@Loc["Register_ConfirmPasswordLabel"]"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Required="true" RequiredError="@Loc["Register_ConfirmPasswordRequired"]" Variant="Variant.Outlined" autocomplete="new-password"
                      Validation="@(new Func<string, string?>(ValidateConfirm))" />

        <MudSelect T="int" For="@(() => _model.GroupId)" @bind-Value="_model.GroupId" Label="@Loc["Register_GroupLabel"]" Required="true"
                   RequiredError="@Loc["Register_GroupRequired"]" Variant="Variant.Outlined" Placeholder="@Loc["Register_GroupPlaceholder"]">
            @foreach (var group in _groups)
            {
                <MudSelectItem T="int" Value="group.Id">@group.Name</MudSelectItem>
            }
        </MudSelect>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6" Disabled="_busy">
            @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            @Loc["Register_SubmitButton"]
        </MudButton>
    </EditForm>

    <div class="fc-auth-links">
        <MudLink Href="/login">@Loc["Register_HaveAccount"]</MudLink>
    </div>
    </div>
</section>
