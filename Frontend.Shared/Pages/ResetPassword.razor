@page "/reset-password"
@layout AuthLayout

<PageTitle>@Loc["ResetPassword_PageTitle"]</PageTitle>

<section class="fc-auth-card">
    <AuthIntro />
    <div class="fc-auth-form">
    <MudText Typo="Typo.h5">@Loc["ResetPassword_Title"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-5 fc-muted">
        @Loc["ResetPassword_Subtitle"]
    </MudText>

    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true" novalidate>
    <MudForm @ref="_form">
        <MudTextField @bind-Value="_email" Immediate="true" Label="@Loc["Common_EmailLabel"]" InputType="InputType.Email"
                      Required="true" RequiredError="@Loc["Common_EmailRequired"]" Variant="Variant.Outlined" autocomplete="email" />
        <MudTextField @bind-Value="_code" Immediate="true" Label="@Loc["ResetPassword_CodeLabel"]"
                      Required="true" RequiredError="@Loc["ResetPassword_CodeRequired"]" Variant="Variant.Outlined" autocomplete="one-time-code" />
        <MudTextField @bind-Value="_newPassword" Immediate="true" Label="@Loc["ResetPassword_NewPasswordLabel"]"
                      InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                      Required="true" RequiredError="@Loc["ResetPassword_NewPasswordRequired"]" Variant="Variant.Outlined" autocomplete="new-password"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _showPassword = !_showPassword)" AdornmentAriaLabel="@Loc["Register_ShowPassword"]" />
    </MudForm>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    }

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
               Disabled="_busy">
        @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
        @Loc["ResetPassword_SubmitButton"]
    </MudButton>
    </form>

    <div class="fc-auth-links">
        <MudLink Href="/login">@Loc["ResetPassword_BackToLogin"]</MudLink>
    </div>
    </div>
</section>
