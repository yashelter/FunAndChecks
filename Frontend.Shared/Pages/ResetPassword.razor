@page "/reset-password"
@layout AuthLayout

<PageTitle>@Loc["ResetPassword_PageTitle"]</PageTitle>

<section class="fc-auth-card">
    <AuthIntro />
    <div class="fc-auth-form">
    <MudText Typo="Typo.h5">@Loc["ResetPassword_Title"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-5 fc-muted">
        @Loc["ResetPassword_Subtitle"]
    </MudText>

    <MudForm @ref="_form">
        <MudTextField @bind-Value="_email" Label="@Loc["Common_EmailLabel"]" InputType="InputType.Email"
                      Required="true" RequiredError="@Loc["Common_EmailRequired"]" Variant="Variant.Outlined" autocomplete="email" />
        <MudTextField @bind-Value="_code" Label="@Loc["ResetPassword_CodeLabel"]"
                      Required="true" RequiredError="@Loc["ResetPassword_CodeRequired"]" Variant="Variant.Outlined" autocomplete="one-time-code" />
        <MudTextField @bind-Value="_newPassword" Label="@Loc["ResetPassword_NewPasswordLabel"]" InputType="InputType.Password"
                      Required="true" RequiredError="@Loc["ResetPassword_NewPasswordRequired"]" Variant="Variant.Outlined" autocomplete="new-password" />
    </MudForm>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
               OnClick="SubmitAsync" Disabled="_busy">
        @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
        @Loc["ResetPassword_SubmitButton"]
    </MudButton>

    <div class="fc-auth-links">
        <MudLink Href="/login">@Loc["ResetPassword_BackToLogin"]</MudLink>
    </div>
    </div>
</section>
