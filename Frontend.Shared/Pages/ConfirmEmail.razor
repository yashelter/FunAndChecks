@page "/confirm-email"
@layout AuthLayout

<PageTitle>@Loc["ConfirmEmail_PageTitle"]</PageTitle>

<section class="fc-auth-card">
    <AuthIntro />
    <div class="fc-auth-form">
    <MudText Typo="Typo.h5">@Loc["ConfirmEmail_Title"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-5 fc-muted">
        @Loc["ConfirmEmail_Subtitle"]
    </MudText>

    <MudForm @ref="_form">
        <MudTextField @bind-Value="_email" Label="@Loc["Common_EmailLabel"]" InputType="InputType.Email"
                      Required="true" RequiredError="@Loc["Common_EmailRequired"]" Variant="Variant.Outlined" autocomplete="email" />
        <MudTextField @bind-Value="_code" Label="@Loc["ConfirmEmail_CodeLabel"]"
                      Required="true" RequiredError="@Loc["ConfirmEmail_CodeRequired"]" Variant="Variant.Outlined" autocomplete="one-time-code" />
    </MudForm>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    }
    @if (_info is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4">@_info</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
               OnClick="SubmitAsync" Disabled="_busy">
        @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
        @Loc["ConfirmEmail_SubmitButton"]
    </MudButton>

    <div class="fc-auth-links">
        <MudLink Href="/login">@Loc["Common_BackToLogin"]</MudLink>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ResendAsync" Disabled="_busy">
            @Loc["ConfirmEmail_ResendButton"]
        </MudButton>
    </div>
    </div>
</section>
