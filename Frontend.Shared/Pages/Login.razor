@page "/login"
@layout AuthLayout

<PageTitle>@Loc["Login_PageTitle"]</PageTitle>

<section class="fc-auth-card">
    <AuthIntro />
    <div class="fc-auth-form">
    <MudText Typo="Typo.h5">@Loc["Login_Title"]</MudText>

    <MudForm @ref="_form">
        <MudTextField @bind-Value="_email" Label="@Loc["Common_EmailLabel"]" InputType="InputType.Email"
                      Required="true" RequiredError="@Loc["Common_EmailRequired"]" Variant="Variant.Outlined" autocomplete="email" />
        <MudTextField @bind-Value="_password" Label="@Loc["Login_PasswordLabel"]" InputType="InputType.Password"
                      Required="true" RequiredError="@Loc["Common_PasswordRequired"]"
                      OnKeyDown="HandleKeyDownAsync" Variant="Variant.Outlined" autocomplete="current-password" />
    </MudForm>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        @if (_emailNotConfirmed)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-2"
                       OnClick="GoToConfirm">@Loc["Login_ConfirmEmailButton"]</MudButton>
        }
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
               OnClick="SubmitAsync" Disabled="_busy">
        @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
        @Loc["Login_SubmitButton"]
    </MudButton>

    <div class="fc-auth-links">
        <MudLink Href="/register">@Loc["Login_GoToRegister"]</MudLink>
        <MudLink Href="/forgot-password">@Loc["Login_ForgotPassword"]</MudLink>
    </div>
    <div class="fc-auth-public-link">
        <MudLink Href="/results">@Loc["Login_ViewResults"]</MudLink>
    </div>
    </div>
</section>
