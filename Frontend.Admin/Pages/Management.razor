@page "/admin/management"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]
@using Frontend.Admin.UI

<PageTitle>@Loc["Management_PageTitle"]</PageTitle>

<div class="fc-page-heading"><div><span class="fc-eyebrow">@Loc["Management_Title"]</span><MudText Typo="Typo.h4">@Loc["Management_Title"]</MudText></div></div>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="fc-management-mobile"><MudSelect T="string" @bind-Value="_section" Label="@Loc["Management_Title"]" Variant="Variant.Outlined">
        @foreach (var section in ManagementSections)
        {
            var sectionId = section.Id;
            <MudSelectItem T="string" Value="@sectionId">@Loc[section.Label]</MudSelectItem>
        }
    </MudSelect></div>
    <div class="fc-management-layout">
        <nav class="fc-panel fc-management-nav" aria-label="@Loc["Management_Title"]">
            @foreach (var section in ManagementSections)
            {
                var sectionId = section.Id;
                var sectionIcon = section.Icon;
                <button type="button" class="fc-management-link @(_section == sectionId ? "active" : "")" aria-current="@(_section == sectionId ? "page" : null)" @onclick="@(() => _section = sectionId)"><MudIcon Icon="@sectionIcon" Size="Size.Small" />@Loc[section.Label]</button>
            }
        </nav>
        <div class="fc-management-content">

        @if (_section == "queues")
        {
            <section class="fc-panel fc-management-section"><MudText Typo="Typo.h6" Class="mb-4">@Loc["Management_TabQueues"]</MudText>
            <MudCard Class="mb-4">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">@Loc["Management_CreateQueue"]</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <Frontend.Admin.UI.QueueCreateForm Subjects="@QueueSubjects" Groups="@QueueGroups" SubjectId="_queueSubjectId" Created="OnQueueCreatedAsync" />
                </MudCardContent>
            </MudCard>

            <MudTable Class="fc-management-table" Breakpoint="Breakpoint.Sm" Items="_queues" Hover="true" Dense="true"
                      CanCancelEdit="true" EditTrigger="TableEditTrigger.EditButton" RowEditCommit="OnQueueCommit">
                <HeaderContent>
                    <MudTh>@Loc["Management_ColName"]</MudTh>
                    <MudTh>@Loc["Management_ColDate"]</MudTh>
                    <MudTh>@Loc["Management_ColSelfJoin"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Loc["Management_ColName"]"><strong>@context.Name</strong></MudTd>
                    <MudTd DataLabel="@Loc["Management_ColDate"]">@context.EventDateTime.ToLocalTime().ToString("g")</MudTd>
                    <MudTd DataLabel="@Loc["Management_ColSelfJoin"]">
                        <MudSwitch T="bool" Value="context.AllowSelfJoin" ValueChanged="@(v => SetQueueSelfJoinAsync(context, v))" Color="Color.Primary"
                                   aria-label="@Loc["Management_ColSelfJoin"]" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="@Loc["Common_Delete"]"
                                       OnClick="@(() => DeleteQueueAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <RowEditingTemplate>
                    <MudTd DataLabel="@Loc["Management_ColName"]"><MudTextField @bind-Value="context.Name" /></MudTd>
                    <MudTd DataLabel="@Loc["Management_ColDate"]"><MudTextField @bind-Value="context.LocalDateTimeText" HelperText="@Loc["Management_DateHelper"]" /></MudTd>
                    <MudTd DataLabel="@Loc["Management_ColSelfJoin"]"><MudSwitch T="bool" @bind-Value="context.AllowSelfJoin" Color="Color.Primary" aria-label="@Loc["Management_ColSelfJoin"]" /></MudTd>
                    <MudTd></MudTd>
                </RowEditingTemplate>
            </MudTable>
        </section>
        }

        @if (_section == "subjects")
        {
            <section class="fc-panel fc-management-section"><MudText Typo="Typo.h6" Class="mb-4">@Loc["Management_TabSubjects"]</MudText>
            <div class="fc-management-form" >
                <MudTextField @bind-Value="_newSubjectName" Label="@Loc["Management_NewSubjectLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="int" SelectedValues="_newSubjectGroupIds" SelectedValuesChanged="@(v => _newSubjectGroupIds = v.ToList())"
                           MultiSelection="true" ToStringFunc="@(id => _groups.FirstOrDefault(g => g.Id == id)?.Name ?? "")"
                           Label="@Loc["Management_GroupAccessLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Disabled="@(!_isSuperAdmin)" HelperText="@(_isSuperAdmin ? null : Loc["Management_SubjectPermissionRequired"].Value)"
                           Placeholder="@Loc["Management_GroupAccessPlaceholder"]" Style="min-width: 0;"
                           MultiSelectionTextFunc="@(items => items.Count == 0 ? "" : string.Format(Loc["Management_GroupCount"], items.Count))">
                    @foreach (var g in _groups) { <MudSelectItem T="int" Value="@g.Id">@g.Name</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSubjectAsync">@Loc["Common_Add"]</MudButton>
            </div>
            <MudTable Class="fc-management-table" Breakpoint="Breakpoint.Sm" Items="_subjects" Hover="true" Dense="true" CanCancelEdit="true" EditTrigger="TableEditTrigger.EditButton" RowEditCommit="OnSubjectCommit" RowEditableFunc="@(subject => CanUseSubject(subject.Id))">
                <HeaderContent><MudTh>@Loc["Management_ColName"]</MudTh><MudTh>@Loc["Management_ColGroups"]</MudTh><MudTh>@Loc["Management_ColAttendance"]</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Loc["Management_ColName"]">@context.Name</MudTd>
                    <MudTd DataLabel="@Loc["Management_ColGroups"]">@(CanUseSubject(context.Id) ? AccessChips(GroupNamesOf(context.Id), Loc["Management_NoGroupAccess"]) : null)</MudTd>
                    <MudTd DataLabel="@Loc["Management_ColAttendance"]"><MudSwitch T="bool" Value="context.AttendanceEnabled" ValueChanged="@(v => SetAttendanceEnabledAsync(context, v))" Disabled="IsSubjectRestricted(context.Id)" Color="Color.Primary" aria-label="@Loc["Management_AttendanceLabel"]">@Loc["Management_AttendanceTracking"]</MudSwitch></MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.GroupWork"
                                   Disabled="@(!CanUseSubject(context.Id))" OnClick="@(() => OpenSubjectAccessAsync(context))">@Loc["Common_Access"]</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="@Loc["Common_Delete"]"
                                       OnClick="@(() => DeleteSubjectAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <RowEditingTemplate>
                    <MudTd DataLabel="@Loc["Management_ColName"]"><MudTextField @bind-Value="context.Name" /></MudTd>
                    <MudTd DataLabel="@Loc["Management_ColGroups"]">@AccessChips(GroupNamesOf(context.Id), Loc["Management_NoGroupAccess"])</MudTd>
                    <MudTd DataLabel="@Loc["Management_ColAttendance"]">@(context.AttendanceEnabled ? Loc["Common_Enabled"] : Loc["Common_Disabled"])</MudTd>
                    <MudTd></MudTd>
                </RowEditingTemplate>
            </MudTable>
        </section>
        }

        @if (_section == "groups")
        {
            <section class="fc-panel fc-management-section"><MudText Typo="Typo.h6" Class="mb-4">@Loc["Management_TabGroups"]</MudText>
            <div class="fc-management-form" >
                <MudTextField @bind-Value="_newGroupName" Label="@Loc["Management_NewGroupLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="int" SelectedValues="_newGroupSubjectIds" SelectedValuesChanged="@(v => _newGroupSubjectIds = v.ToList())"
                           MultiSelection="true" ToStringFunc="@(id => _subjects.FirstOrDefault(s => s.Id == id)?.Name ?? "")"
                           Label="@Loc["Management_SubjectAccessLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Placeholder="@Loc["Management_SubjectAccessPlaceholder"]" Style="min-width: 0;"
                           MultiSelectionTextFunc="@(items => items.Count == 0 ? "" : string.Format(Loc["Management_SubjectCount"], items.Count))">
                    @foreach (var s in AvailableSubjects) { <MudSelectItem T="int" Value="@s.Id">@s.Name</MudSelectItem> }
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateGroupAsync">@Loc["Common_Add"]</MudButton>
            </div>
            <MudTable Class="fc-management-table" Breakpoint="Breakpoint.Sm" Items="_groups" Hover="true" Dense="true" CanCancelEdit="true" EditTrigger="TableEditTrigger.EditButton" RowEditCommit="OnGroupCommit">
                <HeaderContent><MudTh>@Loc["Management_ColName"]</MudTh><MudTh>@Loc["Management_ColSubjects"]</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Loc["Management_ColName"]">@context.Name</MudTd>
                    <MudTd DataLabel="@Loc["Management_ColSubjects"]">@AccessChips(SubjectNamesOf(context.Id), Loc["Management_NoSubjectAccess"])</MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.MenuBook"
                                   OnClick="@(() => OpenGroupAccessAsync(context))">@Loc["Common_Access"]</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="@Loc["Common_Delete"]"
                                       OnClick="@(() => DeleteGroupAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <RowEditingTemplate>
                    <MudTd DataLabel="@Loc["Management_ColName"]"><MudTextField @bind-Value="context.Name" /></MudTd>
                    <MudTd DataLabel="@Loc["Management_ColSubjects"]">@AccessChips(SubjectNamesOf(context.Id), Loc["Management_NoSubjectAccess"])</MudTd>
                    <MudTd></MudTd>
                </RowEditingTemplate>
            </MudTable>
        </section>
        }

        @if (_section == "tasks")
        {
            <section class="fc-panel fc-management-section"><MudText Typo="Typo.h6" Class="mb-4">@Loc["Management_TabTasks"]</MudText>
            <MudSelect T="int?" Value="_taskSubjectId" ValueChanged="OnTaskSubjectChanged" Label="@Loc["Common_Subject"]"
                       Variant="Variant.Outlined" Class="mb-4" Placeholder="@Loc["Management_SelectSubject"]">
                @foreach (var s in AvailableSubjects) { <MudSelectItem T="int?" Value="@s.Id">@s.Name</MudSelectItem> }
            </MudSelect>

            @if (_taskSubjectId is not null)
            {
                <details class="fc-management-bulk fc-management-task-groups" open="@(_taskGroups.Count > 0)">
                    <summary>@Loc["Management_TaskGroupsTitle", _taskGroups.Count]</summary>
                    <MudText Typo="Typo.caption" Class="fc-muted">@Loc["Management_TaskGroupsHint"]</MudText>
                    <form class="fc-management-form" @onsubmit="CreateTaskGroupAsync" @onsubmit:preventDefault="true">
                        <MudTextField @bind-Value="_newTaskGroupName" Immediate="true" Label="@Loc["Management_TaskGroupNameLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_newTaskGroupName)">@Loc["Common_Add"]</MudButton>
                    </form>
                    @if (_taskGroups.Count > 0)
                    {
                        <MudTable Class="fc-management-table" Breakpoint="Breakpoint.Sm" Items="_taskGroups" Hover="true" Dense="true" CanCancelEdit="true" EditTrigger="TableEditTrigger.EditButton" RowEditCommit="OnTaskGroupCommit">
                            <HeaderContent><MudTh>@Loc["Management_ColName"]</MudTh><MudTh>@Loc["Management_ColTaskCount"]</MudTh><MudTh></MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@Loc["Management_ColName"]">@context.Name</MudTd>
                                <MudTd DataLabel="@Loc["Management_ColTaskCount"]">@context.TaskCount</MudTd>
                                <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="@Loc["Common_Delete"]"
                                                      OnClick="@(() => DeleteTaskGroupAsync(context))" /></MudTd>
                            </RowTemplate>
                            <RowEditingTemplate>
                                <MudTd DataLabel="@Loc["Management_ColName"]"><MudTextField @bind-Value="context.Name" MaxLength="200" aria-label="@Loc["Management_ColName"]" /></MudTd>
                                <MudTd DataLabel="@Loc["Management_ColTaskCount"]">@context.TaskCount</MudTd>
                                <MudTd></MudTd>
                            </RowEditingTemplate>
                        </MudTable>
                    }
                </details>

                @* Создание: виден один способ за раз, и группа задач в нём относится только к нему. *@
                <div class="fc-task-create">
                    <div class="fc-task-create-head">
                        <strong>@Loc["Management_TaskCreateTitle"]</strong>
                        <div class="fc-task-modes" role="group" aria-label="@Loc["Management_TaskModeLabel"]">
                            @foreach (var mode in TaskCreateModes)
                            {
                                <button type="button" class="@(_taskCreateMode == mode.Id ? "active" : "")" aria-pressed="@(_taskCreateMode == mode.Id ? "true" : "false")"
                                        @onclick="@(() => _taskCreateMode = mode.Id)">@Loc[mode.Label]</button>
                            }
                        </div>
                    </div>

                    @if (_taskCreateMode == TaskCreateMode.Single)
                    {
                        @* Enter добавляет задачу и возвращает фокус в название — задачи вводятся подряд с клавиатуры. *@
                        <form class="fc-management-form fc-task-create-form" @onsubmit="CreateTaskAsync" @onsubmit:preventDefault="true">
                            <MudTextField @ref="_taskNameField" @bind-Value="_newTaskName" Immediate="true" Label="@Loc["Management_TaskLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField @bind-Value="_newTaskDescription" Immediate="true" Label="@Loc["Management_TaskDescriptionLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudNumericField @bind-Value="_newTaskMaxPoints" Immediate="true" Label="@Loc["Management_TaskPointsLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Style="width: 100px;" />
                            @NewTaskGroupSelect
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@string.IsNullOrWhiteSpace(_newTaskName)">@Loc["Common_Add"]</MudButton>
                        </form>
                    }
                    else if (_taskCreateMode == TaskCreateMode.List)
                    {
                        <div class="fc-task-create-form">
                            <MudTextField @bind-Value="_bulkTasks" Immediate="true" Lines="5" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Label="@Loc["Management_TasksBulkLabel"]" Placeholder="1.1;2&#10;1.2;2;Описание" />
                            <div class="fc-management-bulk-actions">
                                @NewTaskGroupSelect
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(string.IsNullOrWhiteSpace(_bulkTasks) || _bulkBusy)" OnClick="AddBulkTasksAsync">@Loc["Management_TasksBulkAdd"]</MudButton>
                            </div>
                        </div>
                    }
                    else if (_taskCreateMode == TaskCreateMode.Set)
                    {
                        <div class="fc-task-create-form">
                            <MudText Typo="Typo.caption" Class="fc-muted">@Loc["Management_TaskSetHint"]</MudText>
                            <div class="fc-management-bulk-actions">
                                <MudTextField @bind-Value="_setPrefix" Immediate="true" Label="@Loc["Management_TaskSetPrefix"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 140px;" />
                                <MudNumericField @bind-Value="_setCount" Immediate="true" Label="@Loc["Management_TaskSetCount"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="99" Style="width: 140px;" />
                                <MudNumericField @bind-Value="_setPoints" Immediate="true" Label="@Loc["Management_TaskPointsLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Style="width: 100px;" />
                                @NewTaskGroupSelect
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(TaskSetPreview is null || _bulkBusy)" OnClick="CreateTaskSetAsync">@Loc["Management_TaskSetCreate"]</MudButton>
                            </div>
                            @if (TaskSetPreview is string preview) { <MudText Typo="Typo.body2">@preview</MudText> }
                        </div>
                    }
                    else
                    {
                        <div class="fc-task-create-form">
                            <MudText Typo="Typo.caption" Class="fc-muted">@Loc["Management_CopyTasksHint"]</MudText>
                            <div class="fc-management-bulk-actions">
                                <MudSelect T="int?" Value="_copyFromSubjectId" ValueChanged="CopyTasksFromAsync" Label="@Loc["Management_CopyTasksFrom"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_bulkBusy">
                                    @foreach (var s in AvailableSubjects.Where(s => s.Id != _taskSubjectId)) { <MudSelectItem T="int?" Value="@s.Id">@s.Name</MudSelectItem> }
                                </MudSelect>
                            </div>
                        </div>
                    }
                </div>

                @if (_tasks.Count > 1)
                {
                    <MudText Typo="Typo.caption" Class="fc-muted fc-task-bulk-hint">@Loc["Management_BulkHint"]</MudText>
                }
                @* Галочки можно протянуть: нажать на одну и вести по соседним (table-drag-select.js). *@
                <div @ref="_tasksTableHost" class="fc-drag-select">
                <MudTable Class="fc-management-table" Breakpoint="Breakpoint.Sm" Items="_tasks" Hover="true" Dense="true" CanCancelEdit="true" EditTrigger="TableEditTrigger.EditButton" RowEditCommit="OnTaskCommit"
                          MultiSelection="true" SelectOnRowClick="false" @bind-SelectedItems="_selectedTasks">
                    <HeaderContent><MudTh>@Loc["Management_ColName"]</MudTh><MudTh>@Loc["Management_ColDescription"]</MudTh><MudTh>@Loc["Management_ColPoints"]</MudTh><MudTh>@Loc["Management_TaskGroupLabel"]</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@Loc["Management_ColName"]">@context.Name</MudTd>
                        <MudTd DataLabel="@Loc["Management_ColDescription"]">@context.Description</MudTd>
                        <MudTd DataLabel="@Loc["Management_ColPoints"]">@context.MaxPoints</MudTd>
                        <MudTd DataLabel="@Loc["Management_TaskGroupLabel"]"><span class="@(context.TaskGroupId is null ? "fc-muted" : "")">@TaskGroupName(context.TaskGroupId)</span></MudTd>
                        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="@Loc["Common_Delete"]"
                                              OnClick="@(() => DeleteTaskAsync(context))" /></MudTd>
                    </RowTemplate>
                    <RowEditingTemplate>
                        <MudTd DataLabel="@Loc["Management_ColName"]"><MudTextField @bind-Value="context.Name" aria-label="@Loc["Management_ColName"]" /></MudTd>
                        <MudTd DataLabel="@Loc["Management_ColDescription"]"><MudTextField @bind-Value="context.Description" aria-label="@Loc["Management_ColDescription"]" /></MudTd>
                        <MudTd DataLabel="@Loc["Management_ColPoints"]"><MudNumericField @bind-Value="context.MaxPoints" Min="0" aria-label="@Loc["Management_ColPoints"]" /></MudTd>
                        <MudTd DataLabel="@Loc["Management_TaskGroupLabel"]">
                            <MudSelect T="int" @bind-Value="context.GroupSelection" aria-label="@Loc["Management_TaskGroupLabel"]">
                                <MudSelectItem T="int" Value="0">@Loc["TaskGroup_None"]</MudSelectItem>
                                @foreach (var g in _taskGroups) { <MudSelectItem T="int" Value="@g.Id">@g.Name</MudSelectItem> }
                            </MudSelect>
                        </MudTd>
                        <MudTd></MudTd>
                    </RowEditingTemplate>
                </MudTable>
                </div>
                @* Массовое изменение — под таблицей и прилипает к низу экрана: появляясь, не сдвигает строки, пока их протягивают. *@
                @if (_selectedTasks.Count > 0)
                {
                    <div class="fc-task-bulk-bar" role="region" aria-label="@Loc["Management_TasksSelected", _selectedTasks.Count]">
                        <strong>@Loc["Management_TasksSelected", _selectedTasks.Count]</strong>
                        <MudSelect T="int" @bind-Value="_bulkGroupSelection" Label="@Loc["Management_TaskGroupLabel"]" HelperText="@TaskGroupsEmptyHint"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 170px;">
                            <MudSelectItem T="int" Value="KeepValue">@Loc["Management_BulkKeep"]</MudSelectItem>
                            <MudSelectItem T="int" Value="0">@Loc["TaskGroup_None"]</MudSelectItem>
                            @foreach (var g in _taskGroups) { <MudSelectItem T="int" Value="@g.Id">@g.Name</MudSelectItem> }
                        </MudSelect>
                        <MudNumericField T="int?" @bind-Value="_bulkPoints" Immediate="true" Label="@Loc["Management_TaskPointsLabel"]" Placeholder="@Loc["Management_BulkKeep"]"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="1000" Clearable="true" Style="width: 140px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!BulkHasChanges || _bulkBusy)" OnClick="ApplyBulkEditAsync">@Loc["Management_BulkApply"]</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="_bulkBusy" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedTasksAsync">@Loc["Management_BulkDelete"]</MudButton>
                        <MudButton Variant="Variant.Text" Disabled="_bulkBusy" OnClick="ClearTaskSelection">@Loc["Management_BulkClear"]</MudButton>
                    </div>
                }
            }
        </section>
        }

        @if (_section == "grades")
        {
            <section class="fc-panel fc-management-section"><MudText Typo="Typo.h6" Class="mb-4">@Loc["Management_TabGradeComponents"]</MudText>
            <MudSelect T="int?" Value="_componentSubjectId" ValueChanged="OnComponentSubjectChanged" Label="@Loc["Common_Subject"]"
                       Variant="Variant.Outlined" Class="mb-4" Placeholder="@Loc["Management_SelectSubject"]">
                @foreach (var s in AvailableSubjects) { <MudSelectItem T="int?" Value="@s.Id">@s.Name</MudSelectItem> }
            </MudSelect>

            @if (_componentSubjectId is not null)
            {
                <div class="fc-management-form">
                    <MudTextField @bind-Value="_newComponentName" Label="@Loc["Management_NewComponentLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudNumericField @bind-Value="_newComponentMin" Label="@Loc["Management_MinPointsLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Style="width: 90px;" />
                    <MudNumericField @bind-Value="_newComponentMax" Label="@Loc["Management_MaxPointsShortLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Style="width: 90px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateComponentAsync">@Loc["Common_Add"]</MudButton>
                </div>
                <MudTable Class="fc-management-table" Breakpoint="Breakpoint.Sm" Items="_components" Hover="true" Dense="true" CanCancelEdit="true" EditTrigger="TableEditTrigger.EditButton" RowEditCommit="OnComponentCommit">
                    <HeaderContent><MudTh>@Loc["Management_ColName"]</MudTh><MudTh>@Loc["Management_MinPointsLabel"]</MudTh><MudTh>@Loc["Management_MaxPointsShortLabel"]</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@Loc["Management_ColName"]">@context.Name</MudTd>
                        <MudTd DataLabel="@Loc["Management_MinPointsLabel"]">@context.MinPoints</MudTd>
                        <MudTd DataLabel="@Loc["Management_MaxPointsShortLabel"]">@context.MaxPoints</MudTd>
                        <MudTd><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="@Loc["Common_Delete"]"
                                              OnClick="@(() => DeleteComponentAsync(context))" /></MudTd>
                    </RowTemplate>
                    <RowEditingTemplate>
                        <MudTd><MudTextField @bind-Value="context.Name" /></MudTd>
                        <MudTd DataLabel="@Loc["Management_MinPointsLabel"]"><MudNumericField @bind-Value="context.MinPoints" Min="0" aria-label="@Loc["Management_MinPointsLabel"]" /></MudTd>
                        <MudTd DataLabel="@Loc["Management_MaxPointsShortLabel"]"><MudNumericField @bind-Value="context.MaxPoints" Min="1" aria-label="@Loc["Management_MaxPointsShortLabel"]" /></MudTd>
                        <MudTd></MudTd>
                    </RowEditingTemplate>
                </MudTable>
            }
        </section>
        }

        @if (_section == "visibility")
        {
            <section class="fc-panel fc-management-section"><MudText Typo="Typo.h6" Class="mb-4">@Loc["Management_VisibilityTab"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                @Loc["Management_VisibilityHint"]
            </MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <VisibilityList Title="@Loc["Management_SubjectsTitle"]"
                                    Items="@(_subjects.Select(s => new VisibilityList.Entry(s.Id, s.Name, IsSubjectArchived(s.Id), IsSubjectRestricted(s.Id))).ToList())"
                                    OnArchiveChanged="@(change => SetSubjectArchivedAsync(change.Id, change.Archived))" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <VisibilityList Title="@Loc["Management_GroupsTitle"]"
                                    Items="@(_groups.Select(g => new VisibilityList.Entry(g.Id, g.Name, IsGroupArchived(g.Id), IsGroupRestricted(g.Id))).ToList())"
                                    OnArchiveChanged="@(change => SetGroupArchivedAsync(change.Id, change.Archived))" />
                </MudItem>
            </MudGrid>
        </section>
        }

    </div>
    </div>
}

@code {
    /// <summary>Список доступов строкой меток; пустой — приглушённая надпись. Не загрузилось — ничего.</summary>
    private RenderFragment AccessChips(IEnumerable<string> names, string empty) => @<text>
        @if (!_accessLinksFailed)
        {
            var list = names.ToList();
            if (list.Count == 0) { <span class="fc-muted fc-access-empty">@empty</span> }
            else { <span class="fc-access-chips">@foreach (var name in list) { <span class="fc-access-chip">@name</span> }</span> }
        }
    </text>;

    /// <summary>Группа задач в форме создания — только для того способа, что сейчас открыт.</summary>
    private RenderFragment NewTaskGroupSelect => @<text>
        <MudSelect T="int" @bind-Value="_newTaskGroupId" Label="@Loc["Management_TaskGroupForCreate"]" HelperText="@TaskGroupsEmptyHint"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 200px;">
            <MudSelectItem T="int" Value="0">@Loc["TaskGroup_None"]</MudSelectItem>
            @foreach (var g in _taskGroups) { <MudSelectItem T="int" Value="@g.Id">@g.Name</MudSelectItem> }
        </MudSelect>
    </text>;

    /// <summary>Списки групп видны всегда; пока групп нет — подсказка, где их создать.</summary>
    private string? TaskGroupsEmptyHint => _taskGroups.Count == 0 ? Loc["Management_TaskGroupsEmptyHint"] : null;
}
