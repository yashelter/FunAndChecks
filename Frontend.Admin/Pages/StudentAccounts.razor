@page "/admin/student-accounts"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.SuperAdmin)]
@implements IDisposable
@using Frontend.Admin.UI
@inject StudentsApi Students
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppStrings> Loc

<PageTitle>@Loc["Grading_ManageAccounts"]</PageTitle>

<StudentDirectoryHeading Accounts="true" />

<section class="fc-panel fc-grading-panel">
    <div class="fc-grading-toolbar">
        <MudTextField T="string" Value="_query" ValueChanged="value => QueryChangedAsync(value)" Label="@Loc["Grading_SearchLabel"]"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="300" MaxLength="200"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" />
    </div>
    <div class="fc-grading-filters" role="group" aria-label="@Loc["Grading_AccountStatus"]">
        <button type="button" aria-pressed="@(_status is null ? "true" : "false")" @onclick="() => SelectStatusAsync(null)">
            @Loc["Grading_AllAccounts"]
        </button>
        @foreach ((string status, string label) in _accountStatuses)
        {
            <button type="button" @key="status" aria-pressed="@(_status == status ? "true" : "false")" @onclick="() => SelectStatusAsync(status)">
                @Loc[label]
            </button>
        }
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" aria-label="@Loc["Grading_LoadingAccounts"]" />
    }
    else if (_accounts.Count == 0)
    {
        <div class="fc-core-empty"><MudText Class="fc-muted">@Loc["Grading_NoAccounts"]</MudText></div>
    }
    else
    {
        <table class="fc-grading-table fc-grading-accounts" aria-label="@Loc["Grading_Accounts"]">
            <thead>
                <tr>
                    <th scope="col">@Loc["Results_ColName"]</th>
                    <th scope="col" class="fc-grading-group">@Loc["Dashboard_Group"]</th>
                    <th scope="col">@Loc["Grading_AccountStatus"]</th>
                    <th scope="col" class="fc-grading-action-col" aria-label="@Loc["Grading_Actions"]"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserAccountDto account in _accounts)
                {
                    (string status, string label) = Status(account);
                    string group = account.GroupName ?? Loc["EditStudent_NoGroup"].Value;
                    <tr @key="account.Id">
                        <td>
                            @if (status == ACTIVE)
                            {
                                <UserChip UserId="account.Id" Name="@Name(account)" Compact="true" />
                            }
                            else
                            {
                                <span class="fc-grading-account-name">@Name(account)</span>
                            }
                            @if (account.HasStudentProfile)
                            {
                                <span class="fc-grading-email">@account.Email</span>
                            }
                            <span class="fc-grading-mobile-group">@group</span>
                        </td>
                        <td class="fc-grading-group">@group</td>
                        <td>
                            <span class="fc-grading-status @(status == ACTIVE ? "fc-semantic-success" : status == PENDING_EMAIL ? "fc-semantic-warning" : "fc-muted")">
                                @Loc[label]
                            </span>
                        </td>
                        <td>
                            <div class="fc-grading-actions">
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" Disabled="_deleting" Size="Size.Small"
                                               aria-label="@DeleteLabel(account)" OnClick="@(() => DeleteAsync(account))" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="fc-grading-footer">
            <span aria-live="polite">@Loc["Grading_AccountRange", FirstAccount, FirstAccount + _accounts.Count - 1, _totalCount]</span>
            @if (PageCount > 1)
            {
                <MudPagination Count="PageCount" Selected="_page" SelectedChanged="page => PageChangedAsync(page)" Size="Size.Small"
                               BoundaryCount="1" MiddleCount="1" ShowFirstButton="true" ShowLastButton="true" />
            }
        </div>
    }
</section>

@code {
    private const int PAGE_SIZE = 25;
    private const string ACTIVE = "Active";
    private const string PENDING_EMAIL = "PendingEmail";
    private const string NO_PROFILE = "NoProfile";
    private const string INACTIVE = "Inactive";
    private static readonly (string Status, string Label) _activeStatus = (ACTIVE, "Grading_AccountActive");
    private static readonly (string Status, string Label) _pendingStatus = (PENDING_EMAIL, "Grading_AccountPending");
    private static readonly (string Status, string Label) _noProfileStatus = (NO_PROFILE, "Grading_AccountNoProfile");
    private static readonly (string Status, string Label) _inactiveStatus = (INACTIVE, "Grading_AccountInactive");
    private static readonly (string Status, string Label)[] _accountStatuses =
    [
        _activeStatus, _pendingStatus, _noProfileStatus, _inactiveStatus
    ];
    private List<UserAccountDto> _accounts = [];
    private string _query = string.Empty;
    private string? _status;
    private int _page = 1;
    private int _totalCount;
    private bool _loading;
    private bool _deleting;
    private CancellationTokenSource? _request;
    private int PageCount => CountPages(_totalCount);
    private static int CountPages(int totalCount) => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PAGE_SIZE));
    private int FirstAccount => (_page - 1) * PAGE_SIZE + 1;
    private static string Text(string ru, string en) => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? ru : en;
    private static string Name(UserAccountDto account) => account.HasStudentProfile
        ? $"{account.LastName} {account.FirstName}".Trim()
        : account.Email ?? account.Id.ToString();
    private static string DeleteLabel(UserAccountDto account) => $"{Text("Удалить аккаунт", "Delete account")}: {Name(account)}";
    private static (string Status, string Label) Status(UserAccountDto account) => !account.EmailConfirmed
        ? _pendingStatus
        : !account.HasStudentProfile ? _noProfileStatus : !account.IsActive ? _inactiveStatus : _activeStatus;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task QueryChangedAsync(string? value, CancellationToken cancellationToken = default)
    {
        _query = value ?? string.Empty;
        _page = 1;
        return LoadAsync(cancellationToken);
    }

    private Task SelectStatusAsync(string? status, CancellationToken cancellationToken = default)
    {
        _status = status;
        _page = 1;
        return LoadAsync(cancellationToken);
    }

    private Task PageChangedAsync(int page, CancellationToken cancellationToken = default)
    {
        _page = page;
        return LoadAsync(cancellationToken);
    }

    private async Task LoadAsync(CancellationToken cancellationToken = default)
    {
        _request?.Cancel();
        _request?.Dispose();
        CancellationTokenSource request = _request = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        _loading = true;
        try
        {
            UserAccountPageDto result = await Students.GetAccountsAsync(_query, _page, PAGE_SIZE, _status, request.Token);
            if (request.IsCancellationRequested)
            {
                return;
            }
            int lastPage = CountPages(result.TotalCount);
            if (_page > lastPage)
            {
                _page = lastPage;
                await LoadAsync(cancellationToken);
                return;
            }

            _accounts = result.Items;
            _totalCount = result.TotalCount;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally
        {
            if (ReferenceEquals(_request, request))
                _loading = false;
        }
    }

    private async Task DeleteAsync(UserAccountDto account, CancellationToken cancellationToken = default)
    {
        string details = $"{Name(account)} ({account.Email})";
        bool? confirm = await Dialogs.ShowMessageBoxAsync(Text("Удалить аккаунт?", "Delete account?"),
            $"{details}\n{Text("Аккаунт, профиль студента, сдачи, оценки, записи в очередях и посещаемость будут удалены без возможности восстановления.", "The account, student profile, submissions, grades, queue entries and attendance will be permanently deleted.")}",
            yesText: Text("Удалить аккаунт", "Delete account"), cancelText: Text("Отмена", "Cancel"));
        if (confirm != true)
        {
            return;
        }
        _deleting = true;
        try
        {
            await Students.DeleteAccountAsync(account.Id, cancellationToken);
            Snackbar.Add(Text("Аккаунт удалён", "Account deleted"), Severity.Success);
            await LoadAsync(cancellationToken);
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _deleting = false; }
    }

    public void Dispose()
    {
        _request?.Cancel();
        _request?.Dispose();
    }
}
