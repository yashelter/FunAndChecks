@page "/admin/queues/{EventId:int}"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>@Loc["QueueDetails_PageTitle"]</PageTitle>

@if (_loading)
{
    <div class="fc-panel fc-core-empty" role="status"><MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" /></div>
}
else if (_details is not null)
{
    <div class="fc-page-heading">
        <div>
            <div class="fc-core-back"><MudLink Href="@(_details.IsArchived ? "/admin/queues?view=archive" : "/admin/queues")"><MudIcon Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" />@Loc["AdminNav_Queues"]</MudLink></div>
            <MudText Typo="Typo.h4">@_details.EventName</MudText>
            <MudText Typo="Typo.body2" Class="fc-muted">@_details.SubjectName · @_details.EventDateTime.ToLocalTime().ToString("g")</MudText>
            @if (_details.IsArchived)
            {
                @* Ручной архив — только просмотр: настройки, «Взять следующего» и смена статусов скрыты, сервер их отклоняет. *@
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Inventory2" Class="fc-queue-archived-chip">@Loc["Queue_ArchivedOn", _details.ArchivedAt!.Value.ToLocalTime().ToString("g")]</MudChip>
            }
            else
            {
                <MudSwitch T="bool" Value="_details.AllowSelfJoin" ValueChanged="SetSelfJoinAsync" Color="Color.Primary" Class="fc-queue-selfjoin"
                           Label="@Loc["QueueDetails_SelfJoin"]" title="@Loc["QueueDetails_SelfJoinHint"]" />
                <MudNumericField T="int?" Value="_details.LateAfterMinutes" ValueChanged="SetLateRuleAsync" Min="0" Max="@QueueLateMax"
                                 Label="@Loc["QueueDetails_LateRule"]" HelperText="@Loc["QueueDetails_LateRuleHint"]" Clearable="true"
                                 DebounceInterval="700" Variant="Variant.Outlined" Margin="Margin.Dense" Class="fc-queue-late-rule" />
            }
        </div>
        <div class="fc-queue-heading-actions">
            @if (!_details.IsArchived)
            {
                @* Пока идёт проверка, архивировать нельзя: сначала её завершают (сервер проверяет то же в транзакции). *@
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.Inventory2" OnClick="ArchiveAsync"
                           Disabled="@(Count(QueueEntryStatus.Checking) > 0 || _archiving)" aria-describedby="@(Count(QueueEntryStatus.Checking) > 0 ? "fc-archive-hint" : null)">@Loc["QueueArchive_Action"]</MudButton>
                @if (Count(QueueEntryStatus.Checking) > 0)
                {
                    <small id="fc-archive-hint" class="fc-muted fc-queue-archive-hint">@Loc["QueueArchive_CheckingHint"]</small>
                }
                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="@(_hub?.State == HubConnectionState.Connected ? Color.Success : Color.Warning)"
                         Icon="@(_hub?.State == HubConnectionState.Connected ? Icons.Material.Filled.Circle : Icons.Material.Outlined.SyncProblem)">
                    @Loc[_hub?.State == HubConnectionState.Connected ? "QueueDetails_Live" : "QueueDetails_Offline"]
                </MudChip>
            }
        </div>
    </div>

    @if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">@Loc["QueueDetails_Stale"] <MudLink OnClick="LoadAsync">@Loc["QueueDetails_Retry"]</MudLink></MudAlert>
    }

    <div class="fc-stats fc-queue-stats">
        <div class="fc-stat"><span>@Loc["Queue_StatusWaiting"]</span><strong>@StatCount(QueueEntryStatus.Waiting)</strong></div>
        <div class="fc-stat"><span>@Loc["Queue_StatusChecking"]</span><strong class="fc-semantic-info">@StatCount(QueueEntryStatus.Checking)</strong></div>
        <div class="fc-stat"><span>@Loc["Queue_StatusSkipped"]</span><strong class="fc-semantic-error">@StatCount(QueueEntryStatus.Skipped)</strong></div>
        <div class="fc-stat"><span>@Loc["Queue_StatusFinished"]</span><strong class="fc-semantic-success">@StatCount(QueueEntryStatus.Finished)</strong></div>
    </div>

    @if (!_details.IsArchived)
    {
        <div class="fc-panel fc-queue-next">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.SkipNext" OnClick="TakeNextAsync"
                       Disabled="@(NextWaiting() is null)">@Loc["QueueDetails_TakeNext"]</MudButton>
        </div>
    }

    @if (_participants.Any(p => p.Status == QueueEntryStatus.Checking))
    {
        <section class="fc-panel fc-reviewers">
            <MudText Typo="Typo.subtitle2">@Loc["QueueDetails_Reviewers"]</MudText>
            <div class="fc-reviewer-list">
                @foreach (var participant in _participants.Where(p => p.Status == QueueEntryStatus.Checking))
                {
                    <div class="fc-reviewer"><MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" /><span><strong>@(participant.CheckingByAdminName ?? Loc["Queue_StatusChecking"])</strong><small>@participant.LastName @participant.FirstName</small></span></div>
                }
            </div>
        </section>
    }

    <div class="fc-panel fc-toolbar fc-queue-filters">
        @* Фильтр только по группам, которые есть в этой очереди; «Взять следующего» тоже его учитывает. *@
        <MudSelect T="string" MultiSelection="true" SelectedValues="_groups" SelectedValuesChanged="OnGroupsChangedAsync" MultiSelectionTextFunc="GroupsText"
                   Label="@Loc["QueueDetails_Groups"]" Placeholder="@Loc["AttendanceJournal_AllGroups"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            @foreach (var (group, count) in Groups) { <MudSelectItem T="string" Value="@group">@group <span class="fc-muted">· @count</span></MudSelectItem> }
        </MudSelect>
        <MudSelect T="ParticipantSort" @bind-Value="_sort" Label="@Loc["QueueDetails_SortLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="ParticipantSort" Value="ParticipantSort.Points">@Loc["QueueDetails_SortPoints"]</MudSelectItem>
            <MudSelectItem T="ParticipantSort" Value="ParticipantSort.Group">@Loc["QueueDetails_SortGroup"]</MudSelectItem>
            <MudSelectItem T="ParticipantSort" Value="ParticipantSort.JoinedAt">@Loc["QueueDetails_SortJoinedAt"]</MudSelectItem>
        </MudSelect>
    </div>

    @if (Visible.Count == 0)
    {
        <div class="fc-panel fc-core-empty"><MudText Class="fc-muted">@Loc["QueueDetails_NoParticipants"]</MudText></div>
    }
    else
    {
        <section class="fc-panel fc-queue-participants">
            @foreach (var p in Visible)
            {
                var past = IsPastRound(p);
                <article class="fc-queue-person @QueueClass(p.Status) @(past ? "fc-queue-past-round" : "") @(p.ActiveAchievement is null ? "" : "fc-fx-row")" data-fx="@p.ActiveAchievement?.AchievementId" @key="p.EntryId">
                    <div class="fc-queue-person-identity">
                        <div class="fc-queue-name-cell"><UserChip UserId="p.StudentId" Name="@($"{p.LastName} {p.FirstName}")" NameClass="fc-student-name" NameStyle="@QueueStyles.NameStyle(p.StudentColor)" Compact="true" /><Frontend.Shared.Profiles.ActiveAchievementBadge Achievement="p.ActiveAchievement" /></div>
                        <MudText Typo="Typo.caption" Class="fc-muted">@p.GroupName · @p.JoinedAt.ToLocalTime().ToString("t")@(past ? $" · {Loc["Queue_PastRound", p.Round]}" : "")</MudText>
                        @if (!p.CanManage) { <MudText Typo="Typo.caption" Class="fc-semantic-warning">@Loc["Common_GradingRestricted"]</MudText> }
                        @if (p.LateMinutes is int late && !past)
                        {
                            <div class="fc-queue-late">
                                <MudChip T="string" Size="Size.Small" Variant="@(p.LateExcused ? Variant.Outlined : Variant.Text)" Color="@(p.LateExcused ? Color.Default : Color.Warning)"
                                         Icon="@Icons.Material.Outlined.Schedule">@(p.LateExcused ? Loc["QueueDetails_LateExcusedBadge", late] : Loc["Queue_LateBadge", late])</MudChip>
                                @if (p.CanManage && !_details.IsArchived)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => SetLateExcusedAsync(p, !p.LateExcused))"
                                               title="@Loc[p.LateExcused ? "QueueDetails_LateRestoreHint" : "QueueDetails_LateExcuseHint"]">@Loc[p.LateExcused ? "QueueDetails_LateRestore" : "QueueDetails_LateExcuse"]</MudButton>
                                }
                            </div>
                        }
                    </div>
                    <div class="fc-queue-person-score"><strong>@p.TotalPoints</strong><span>@Loc["Common_PointsAbbr"]</span></div>
                    <div class="fc-queue-person-status"><MudChip T="string" Color="@StatusColor(p.Status)" Size="Size.Small" Variant="Variant.Text">@QueueStyles.StatusText(p.Status, p.CheckingByAdminName, Loc)</MudChip>
                        @if (p.IsRejoin && !past) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="fc-queue-rejoin" title="@Loc["Queue_RoundHint", p.Round, p.JoinedAt.ToLocalTime().ToString("t")]">@Loc["Queue_RejoinBadge"]</MudChip> }</div>
                    <div class="fc-queue-person-action"><MudButton Variant="@(IsReadOnly(p) ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" Disabled="@(!p.CanManage)"
                        OnClick="@(() => OpenStudentAsync(p))" StartIcon="@(IsReadOnly(p) ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.Assignment)">@Loc[IsReadOnly(p) ? "QueueDetails_View" : "QueueDetails_Review"]</MudButton></div>
                </article>
            }
        </section>
    }
}
else
{
    <MudAlert Severity="Severity.Error">@Loc["QueueDetails_LoadError"]</MudAlert>
}
