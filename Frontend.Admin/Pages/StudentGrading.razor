@page "/admin/grading"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>@Loc["Grading_PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@Loc["Grading_Title"]</MudText>

<MudSelect T="int?" @bind-Value="_subjectId" @bind-Value:after="SearchAsync" Label="@Loc["Common_Subject"]" Variant="Variant.Outlined"
           Placeholder="@Loc["Grading_SelectSubject"]" Class="mb-3" Style="max-width: 360px;">
    @foreach (var s in _subjects) { <MudSelectItem T="int?" Value="@s.Id">@s.Name</MudSelectItem> }
</MudSelect>

<MudTextField @bind-Value="_query" Label="@Loc["Grading_SearchLabel"]" Variant="Variant.Outlined"
              Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="SearchAsync"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />

@if (_subjectId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-3">@Loc["Grading_SelectSubjectHint"]</MudAlert>
}
else if (_searching)
{
    <MudProgressLinear Indeterminate="true" Class="mt-3" />
}
else if (_results.Count > 0)
{
    <MudList T="StudentDetailsDto" Class="mt-2">
        @foreach (var student in _results)
        {
            <MudListItem T="StudentDetailsDto" OnClick="@(() => OpenAsync(student))">
                <div class="d-flex justify-space-between align-center flex-grow-1">
                    <span style="@QueueStyles.NameStyle(student.Color)">@student.LastName @student.FirstName</span>
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.caption">@student.Email</MudText>
                        <AuthorizeView Roles="@Roles.SuperAdmin">
                            <Authorized>
                                <span @onclick:stopPropagation="true"><MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@((e) => EditAsync(student))" /></span>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </MudListItem>
            <MudDivider />
        }
    </MudList>
}
else
{
    <MudText Class="mt-3">@Loc["Grading_NoStudents"]</MudText>
}
