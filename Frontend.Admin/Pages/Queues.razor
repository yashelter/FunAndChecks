@page "/admin/queues"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]

<PageTitle>@Loc["Queues_PageTitleActive"]</PageTitle>

<div class="fc-page-heading">
    <div><div class="fc-eyebrow">@Loc["AdminNav_Queues"]</div><MudText Typo="Typo.h4">@Loc["Queues_Title"]</MudText></div>
    <div class="fc-admin-queues-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="CreateAsync">@Loc["Management_CreateQueue"]</MudButton>
    </div>
</div>

@* Текущие перечитываются живо: архивированная в другой вкладке очередь уходит из списка сама. *@
@if (!Archive)
{
    <QueueListSubscription EventIds="_queues.Select(q => q.Id).ToList()" OnChanged="ReloadQuietAsync" />
}

<MudTabs Elevation="0" Rounded="true" MinimumTabWidth="0px" ActivePanelIndex="@(Archive ? 1 : 0)" ActivePanelIndexChanged="OnTabChanged" Class="fc-queue-tabs">
    <MudTabPanel Text="@Loc["Queues_TabCurrent"]">@QueueList(Loc["Queues_Empty"])</MudTabPanel>
    <MudTabPanel Text="@Loc["Queues_TabArchive"]">@QueueList(Loc["Queues_ArchiveEmpty"])</MudTabPanel>
</MudTabs>

@code {
    private RenderFragment QueueList(string empty) => __builder =>
    {
        if (_loading)
        {
            <div class="fc-panel fc-core-empty" role="status"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
        }
        else if (_queues.Count == 0)
        {
            <div class="fc-panel fc-core-empty"><MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Large" /><MudText Class="fc-muted">@empty</MudText></div>
        }
        else
        {
            <div class="fc-queue-cards">
                @foreach (var queue in _queues)
                {
                    <QueueEventCard Event="queue" InArchive="Archive" @key="queue.Id">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Outlined.ArrowForward"
                                   Href="@($"/admin/queues/{queue.Id}")">@Loc["Queues_Open"]</MudButton>
                    </QueueEventCard>
                }
            </div>
        }
    };
}
