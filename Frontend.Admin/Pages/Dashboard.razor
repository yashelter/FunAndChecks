@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = Roles.Admin)]
@using Frontend.Admin.UI

<PageTitle>@Loc["Dashboard_PageTitle"]</PageTitle>

<div class="fc-page-heading">
    <div><div class="fc-eyebrow">@Loc["AdminNav_Results"]</div><MudText Typo="Typo.h4">@Loc["Dashboard_Title"]</MudText></div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FileDownload"
               OnClick="ExportXlsxAsync" Disabled="@(_results is null || _results.UserResults.Count == 0)">
        @Loc["Common_Download"]
    </MudButton>
</div>

<div class="fc-panel fc-toolbar fc-results-filters">
    <MudSelect T="SubjectDto" Value="_selectedSubject" ValueChanged="OnSubjectSelectedAsync" Label="@Loc["Common_SelectSubject"]"
               Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@(s => s?.Name)">
        @foreach (var subject in _subjects)
        {
            <MudSelectItem T="SubjectDto" Value="subject">@subject.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSwitch T="bool" @bind-Value="_showAcceptedTeacherColors" Color="Color.Primary" Label="@Loc["Results_ShowAcceptedTeacherColors"]" Class="fc-results-teacher-colors" />
</div>

@if (_loading)
{
    <div class="fc-panel fc-core-empty" role="status"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_results is not null)
{
    <ResultsColorSubscription SubjectId="_results.SubjectId" OnColorsUpdated="UpdateStudentColors" OnResultUpdated="OnResultUpdatedAsync" />
    <div class="fc-stats fc-results-stats">
        <div class="fc-stat"><span>@Loc["Dashboard_Students"]</span><strong>@_results.UserResults.Count</strong><MudIcon Icon="@Icons.Material.Outlined.People" /></div>
        <div class="fc-stat"><span>@Loc["Dashboard_Tasks"]</span><strong>@_results.TaskHeaders.Count</strong><MudIcon Icon="@Icons.Material.Outlined.Assignment" /></div>
        <div class="fc-stat"><span>@Loc["Dashboard_Accepted"]</span><strong class="fc-semantic-success">@_acceptedCount</strong><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" /></div>
        <div class="fc-stat"><span>@Loc["Dashboard_Rework"]</span><strong class="fc-semantic-warning">@_reworkCount</strong><MudIcon Icon="@Icons.Material.Outlined.History" /></div>
        <div class="fc-stat"><span>@Loc["Results_AveragePoints"]</span><strong>@AveragePoints</strong><MudIcon Icon="@Icons.Material.Outlined.Functions" /></div>
    </div>
    <section class="fc-panel fc-results-panel @(_showAcceptedTeacherColors ? "fc-results-show-teacher" : null)">
        <div class="fc-core-panel-heading"><MudText Typo="Typo.h6">@_results.SubjectName</MudText><MudText Typo="Typo.caption" Class="fc-muted">@CommunityText.Students(_results.UserResults.Count)</MudText></div>
        <AdminResultsGrid Results="_results" Variants="_variants" Attendance="_attendance" OnCellClick="OpenStudentAsync" />
        <div class="fc-results-legend">
            <span><i class="fc-result-cell fc-result-accepted">+</i>@Loc["Task_StatusAccepted"]</span>
            <span><i class="fc-result-cell fc-result-unsubmitted">—</i>@Loc["Task_StatusNotSubmitted"]</span>
            <span>@Loc["Task_StatusRejected"] · @Loc["Common_Reason"] @Loc["Dialog_History"]</span>
        </div>
    </section>
}
else
{
    <div class="fc-panel fc-core-empty"><MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Large" /><MudText Class="fc-muted">@Loc["Dashboard_SelectHint"]</MudText></div>
}
