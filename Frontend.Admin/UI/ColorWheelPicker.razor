@namespace Frontend.Admin.UI
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Цветовое колесо: оттенок — угол (от верха по часовой), насыщенность — расстояние от центра, яркость — ползунок под ним.
   Перетаскивание обрабатывает color-wheel.js; стрелки: ←/→ оттенок, ↑/↓ насыщенность (Shift — крупный шаг). *@
<div class="fc-wheel-picker" aria-disabled="@(Disabled ? "true" : "false")">
    <div class="fc-wheel-row">
        <div @ref="_wheel" class="fc-wheel" role="slider" tabindex="@(Disabled ? -1 : 0)" aria-label="@WheelLabel"
             aria-valuemin="0" aria-valuemax="359" aria-valuenow="@Math.Round(_color.Hue)"
             aria-valuetext="@($"{Math.Round(_color.Hue)}°, {Math.Round(_color.Saturation * 100)}%")"
             data-disabled="@(Disabled ? "true" : "false")" @onkeydown="ChangeWheelKeyAsync">
            <span class="fc-wheel-shade" style="@($"opacity:{Number(1 - _color.Value)};")" aria-hidden="true"></span>
            <span class="fc-wheel-marker" style="@MarkerStyle" aria-hidden="true"></span>
        </div>
        <div class="fc-wheel-side">
            <span class="fc-wheel-swatch" style="@(HasValue ? $"background:{_hex};" : null)" aria-hidden="true">@(HasValue ? null : "—")</span>
            <label>HEX<input @key="_hexRevision" type="text" value="@(HasValue ? _hex : "")" placeholder="#RRGGBB" maxlength="7" spellcheck="false" autocomplete="off"
                             aria-label="HEX" disabled="@Disabled" @onchange="ChangeHexAsync" /></label>
        </div>
    </div>
    <label class="fc-wheel-value-label">@ValueLabel
        <input class="fc-wheel-value" type="range" min="0" max="100" step="1" value="@Math.Round(_color.Value * 100)"
               style="@($"--fc-wheel-full:{FullBrightnessHex};")" disabled="@Disabled" aria-label="@ValueLabel" @oninput="ChangeValueAsync" />
    </label>
    <div class="fc-wheel-presets" role="group" aria-label="@PresetsLabel">
        @foreach (var preset in Presets)
        {
            var active = HasValue && string.Equals(preset, _hex, StringComparison.OrdinalIgnoreCase);
            <button type="button" class="fc-wheel-preset @(active ? "active" : "")" style="@($"background:{preset};")" title="@preset" aria-label="@preset"
                    aria-pressed="@(active ? "true" : "false")" disabled="@Disabled" @onclick="@(() => SelectPresetAsync(preset))"></button>
        }
    </div>
</div>

@code {
    /// <summary>Цвет «#RRGGBB»; null — цвет не выбран (колесо показывает начальное положение).</summary>
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string WheelLabel { get; set; } = "Hue and saturation";
    [Parameter] public string ValueLabel { get; set; } = "Brightness";
    [Parameter] public string PresetsLabel { get; set; } = "Quick colors";

    private static readonly string[] Presets = ["#E53935", "#FB8C00", "#FDD835", "#43A047", "#00ACC1", "#1E88E5", "#8E24AA", "#D81B60"];

    private HsvColor _color = new(160, .75, .8);
    private string _hex = "#33CC99";
    private string? _lastParameter;
    private int _hexRevision;
    private ElementReference _wheel;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ColorWheelPicker>? _reference;
    private bool _disposed;

    private bool HasValue => Value is not null;
    private string FullBrightnessHex => (_color with { Value = 1 }).ToHex();
    private string MarkerStyle
    {
        get
        {
            var angle = _color.Hue * Math.PI / 180;
            var x = 50 + _color.Saturation * 50 * Math.Sin(angle);
            var y = 50 - _color.Saturation * 50 * Math.Cos(angle);
            return $"left:{Number(x)}%;top:{Number(y)}%;background:{_hex};";
        }
    }
    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    protected override void OnParametersSet()
    {
        if (string.Equals(Value, _lastParameter, StringComparison.OrdinalIgnoreCase))
            return;
        _lastParameter = Value;
        if (HsvColor.TryParseHex(Value, out var rgb))
        {
            _color = HsvColor.FromRgb(rgb.R, rgb.G, rgb.B, _color);
            _hex = $"#{rgb.R:X2}{rgb.G:X2}{rgb.B:X2}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Frontend.Admin/color-wheel.js?v=1");
        if (_disposed) { await module.DisposeAsync(); return; }
        _module = module;
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attach", _wheel, _reference);
    }

    [JSInvokable]
    public async Task SetWheelAsync(double hue, double saturation)
    {
        if (_disposed || Disabled || !double.IsFinite(hue) || !double.IsFinite(saturation))
            return;
        // Колесо по чёрному цвету ничего бы не показало: при первом выборе яркость поднимаем.
        var value = HasValue ? _color.Value : Math.Max(_color.Value, .8);
        _color = new HsvColor((hue % 360 + 360) % 360, Math.Clamp(saturation, 0, 1), value);
        await EmitAsync();
        StateHasChanged();
    }

    private async Task ChangeWheelKeyAsync(KeyboardEventArgs e)
    {
        var hueStep = e.ShiftKey ? 10 : 2;
        var saturationStep = e.ShiftKey ? .1 : .02;
        var (hue, saturation) = (_color.Hue, _color.Saturation);
        switch (e.Key)
        {
            case "ArrowLeft": hue -= hueStep; break;
            case "ArrowRight": hue += hueStep; break;
            case "ArrowUp": saturation += saturationStep; break;
            case "ArrowDown": saturation -= saturationStep; break;
            default: return;
        }
        await SetWheelAsync(hue, saturation);
    }

    private async Task ChangeValueAsync(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var percent))
            return;
        _color = _color with { Value = Math.Clamp(percent / 100, 0, 1) };
        await EmitAsync();
    }

    private async Task ChangeHexAsync(ChangeEventArgs e)
    {
        _hexRevision++;
        if (!HsvColor.TryParseHex(e.Value?.ToString(), out var rgb))
            return;
        _color = HsvColor.FromRgb(rgb.R, rgb.G, rgb.B, _color);
        await EmitAsync($"#{rgb.R:X2}{rgb.G:X2}{rgb.B:X2}");
    }

    private async Task SelectPresetAsync(string hex)
    {
        if (!HsvColor.TryParseHex(hex, out var rgb))
            return;
        _color = HsvColor.FromRgb(rgb.R, rgb.G, rgb.B, _color);
        await EmitAsync(hex);
    }

    /// <param name="exact">Цвет ровно как введён (HEX, готовый цвет): пересчёт через HSV мог бы сдвинуть его на единицу.</param>
    private async Task EmitAsync(string? exact = null)
    {
        if (Disabled || _disposed) return;
        _hex = (exact ?? _color.ToHex()).ToUpperInvariant();
        _lastParameter = _hex;
        await ValueChanged.InvokeAsync(_hex);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach", _wheel); }
            catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
        }
        _reference?.Dispose();
    }
}
