@inject IStringLocalizer<AppStrings> Loc

@* Меню преподавателя: «Учёба» открыта всегда, «Сообщество» и «Администрирование» сворачиваются (NavSection).
   Вид меню общий со студентом — dashboard.css. *@
<MudNavMenu>
    <div class="fc-nav-label" role="presentation">@CommunityText.T("Учёба", "Teaching")</div>
    <MudNavLink Href="/admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.TableChart">
        @Loc["AdminNav_Results"]
    </MudNavLink>
    <MudNavLink Href="/admin/management" Icon="@Icons.Material.Outlined.LibraryBooks">
        @Loc["AdminNav_Management"]
    </MudNavLink>
    <MudNavLink Href="/admin/queues" Icon="@Icons.Material.Outlined.FormatListNumbered">
        @Loc["AdminNav_Queues"]
    </MudNavLink>
    <MudNavLink Href="/admin/grading" Icon="@Icons.Material.Outlined.Grading">
        @Loc["AdminNav_Grading"]
    </MudNavLink>
    <MudNavLink Href="/admin/attendance" Icon="@Icons.Material.Outlined.EventAvailable">
        @Loc["Nav_Attendance"]
    </MudNavLink>
    <NavSection Key="community" Title="@CommunityText.T("Сообщество", "Community")" Icon="@Icons.Material.Outlined.Groups"
                     Paths="@(["/admin/achievements", "/admin/forum", "/admin/surveys"])">
        <MudNavLink Href="/admin/achievements" Icon="@Icons.Material.Outlined.EmojiEvents">
            @CommunityText.T("Достижения", "Achievements")
        </MudNavLink>
        <MudNavLink Href="/admin/forum" Icon="@Icons.Material.Outlined.Forum">
            <span class="fc-nav-with-badge">@CommunityText.T("Чаты", "Chats")<ForumUnreadBadge /></span>
        </MudNavLink>
        <MudNavLink Href="/admin/surveys" Icon="@Icons.Material.Outlined.Poll">
            @CommunityText.T("Опросы", "Surveys")
        </MudNavLink>
    </NavSection>
    <AuthorizeView Roles="@Roles.SuperAdmin">
        <NavSection Key="administration" Title="@CommunityText.T("Администрирование", "Administration")" Icon="@Icons.Material.Outlined.Security"
                         Paths="@(["/admin/admins", "/admin/maintenance", "/metrics"])">
            <MudNavLink Href="/admin/admins" Icon="@Icons.Material.Outlined.AdminPanelSettings">
                @Loc["AdminNav_Admins"]
            </MudNavLink>
            <MudNavLink Href="/admin/maintenance" Icon="@Icons.Material.Outlined.Construction">
                @Loc["AdminNav_Maintenance"]
            </MudNavLink>
            <MudNavLink Href="/metrics" Icon="@Icons.Material.Outlined.MonitorHeart">
                @Loc["Monitoring_Title"]
            </MudNavLink>
        </NavSection>
    </AuthorizeView>
</MudNavMenu>
