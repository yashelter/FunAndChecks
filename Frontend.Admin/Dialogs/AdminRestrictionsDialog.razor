@using Frontend.Admin.UI
@implements IDisposable

<MudDialog Class="fc-admin-restrictions-dialog">
    <TitleContent><MudText Typo="Typo.h6">@Loc["AdminMgmt_RestrictionsTitle", Admin.LastName, Admin.FirstName]</MudText></TitleContent>
    <DialogContent>
        @if (!IsPermissionsTab && _scopesLoaded)
        {
            <div class="fc-restriction-bulk">
                <strong>@Loc["AdminPermissions_AllScopes"]</strong>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => SetAllScopes(true))" Disabled="_saving">
                    @Loc["AdminPermissions_RestrictAllScopes"]
                </MudButton>
                <MudButton OnClick="@(() => SetAllScopes(false))" Disabled="_saving">@Loc["AdminPermissions_AllowAllScopes"]</MudButton>
            </div>
        }
        <MudTabs Elevation="0" Rounded="true" Border="true" Class="fc-restriction-tabs"
                 ActivePanelIndex="_activeTab" ActivePanelIndexChanged="@(tab => ChangeTabAsync(tab, _lifetime.Token))">
            <MudTabPanel Text="@Loc["AdminPermissions_Tab"]">
                @if (_permissionsLoading)
                {
                    <MudProgressCircular Indeterminate="true" Class="ma-4" />
                }
                else if (_access is not { } access)
                {
                    <MudButton OnClick="@(() => LoadPermissionsAsync(false, _lifetime.Token))" Variant="Variant.Outlined">@Loc["AdminMgmt_Retry"]</MudButton>
                }
                else if (access.PermissionCatalog is not { Count: > 0 })
                {
                    <MudAlert Severity="Severity.Warning">@Loc["AdminPermissions_CatalogUnavailable"]</MudAlert>
                }
                else
                {
                    <AdminPermissionList Access="access" Selected="_selectedPermissions" Editable="true" Busy="_saving" Changed="TogglePermission" />
                    <MudButton OnClick="SelectAllPermissions" Disabled="_saving" Class="mt-3">@Loc["AdminPermissions_SelectAll"]</MudButton>
                    @if (_permissionsStale)
                    {
                        <MudAlert Severity="Severity.Warning">@Loc["AdminPermissions_Changed"]</MudAlert>
                        <MudButton OnClick="@(() => LoadPermissionsAsync(true, _lifetime.Token))">@Loc["AdminMgmt_Retry"]</MudButton>
                    }
                }
            </MudTabPanel>
            <MudTabPanel Text="@Loc["AdminMgmt_SubjectsTitle"]">
                @if (_scopesLoading)
                {
                    <MudProgressCircular Indeterminate="true" Class="ma-4" />
                }
                else if (!_scopesLoaded)
                {
                    <MudButton OnClick="@(() => LoadScopesAsync(_lifetime.Token))" Variant="Variant.Outlined">@Loc["AdminMgmt_Retry"]</MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-3">@Loc["AdminPermissions_SubjectsHint"]</MudText>
                    @if (_access?.Has(SpecialPermissions.ALL_SUBJECTS) == true || _access?.IsSuperAdmin == true)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">@Loc["AdminPermissions_SubjectsOverrideHint"]</MudAlert>
                    }
                    <RestrictionList Items="_subjects" RestrictedIds="_restrictedSubjects" OnChanged="OnSubjectChanged" AllowedMode="true" Disabled="_saving" />
                }
            </MudTabPanel>
            <MudTabPanel Text="@Loc["AdminMgmt_GroupsTitle"]">
                @if (_scopesLoading)
                {
                    <MudProgressCircular Indeterminate="true" Class="ma-4" />
                }
                else if (!_scopesLoaded)
                {
                    <MudButton OnClick="@(() => LoadScopesAsync(_lifetime.Token))" Variant="Variant.Outlined">@Loc["AdminMgmt_Retry"]</MudButton>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mb-3">@Loc["AdminPermissions_GroupsHint"]</MudText>
                    <RestrictionList Items="_groups" RestrictedIds="_restrictedGroups" OnChanged="OnGroupChanged" Disabled="_saving" />
                }
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAsync" Disabled="_saving">@Loc["Common_Close"]</MudButton>
        @if (IsPermissionsTab)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SavePermissionsAsync(_lifetime.Token))"
                       Disabled="@(_saving || _permissionsLoading || _permissionsStale || !PermissionsChanged)">
                @Loc["AdminPermissions_Save"]
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveScopesAsync(_lifetime.Token))"
                       Disabled="@(_saving || !_scopesLoaded || !ScopesChanged)">
                @Loc["AdminPermissions_SaveScopes"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>
