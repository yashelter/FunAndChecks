<MudDialog Class="fc-comment-dialog" @oninput="_edits.MarkDirty" @onchange="_edits.MarkDirty">
    <TitleContent>
        <MudText Typo="Typo.h6">@Loc["CommentDialog_ReworkTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_comment" Immediate="true" Label="@Loc["CommentDialog_ReworkLabel"]" Variant="Variant.Outlined" Lines="4" AutoFocus="true"
                      OnKeyDown="KeyDownAsync" HelperText="@Loc["CommentDialog_CtrlEnter"]" />
        @if (_recent.Count > 0)
        {
            @* Частые причины возврата — одним кликом, потом можно дописать. *@
            <div class="fc-recent-comments" aria-label="@Loc["CommentDialog_Recent"]">
                <span class="fc-muted">@Loc["CommentDialog_Recent"]:</span>
                @foreach (var text in _recent)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _comment = text)">@Short(text)</MudChip>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">@Loc["CommentDialog_Submit"]</MudButton>
    </DialogActions>
</MudDialog>
