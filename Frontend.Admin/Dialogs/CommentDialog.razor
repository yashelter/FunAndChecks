<MudDialog @oninput="_edits.MarkDirty" @onchange="_edits.MarkDirty">
    <TitleContent>
        <MudText Typo="Typo.h6">@Loc["CommentDialog_ReworkTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_comment" Label="@Loc["CommentDialog_ReworkLabel"]" Variant="Variant.Outlined" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Common_Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">@Loc["CommentDialog_Submit"]</MudButton>
    </DialogActions>
</MudDialog>
