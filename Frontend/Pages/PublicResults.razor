@page "/results"
@layout MainLayout

<PageTitle>@Loc["PublicResults_PageTitle"]</PageTitle>

<div class="fc-public-results">
    <div class="fc-page-heading">
        <div><span class="fc-eyebrow">FUNANDCHECKS</span><MudText Typo="Typo.h4">@Loc["PublicResults_PageTitle"]</MudText><p class="fc-muted">@Loc["Design_ResultsSubtitle"]</p></div>
        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Login">@Loc["PublicResults_LoginButton"]</MudButton>
    </div>

    <section class="fc-panel fc-subject-filter"><div class="fc-panel-body fc-toolbar">
    <MudSelect T="SubjectDto" Value="_selectedSubject" ValueChanged="OnSubjectSelectedAsync" Label="@Loc["Common_SelectSubject"]"
               Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@(s => s?.Name)">
        @foreach (var subject in _subjects)
        {
            <MudSelectItem T="SubjectDto" Value="subject">@subject.Name</MudSelectItem>
        }
    </MudSelect>
    </div></section>

    @if (_loading)
    {
        <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    }
    else if (_results is not null)
    {
        <SubjectResultsView Results="_results" />
    }
    else
    {
        <div class="fc-panel fc-empty">@Loc["Design_ChooseSubject"]</div>
    }
</div>
