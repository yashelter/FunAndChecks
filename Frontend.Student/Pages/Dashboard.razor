@page "/student"
@layout StudentLayout
@attribute [Authorize(Roles = Roles.Student)]

<PageTitle>@(_selectedSubject is { } current ? $"{current.Name} · {Loc["StudentDashboard_PageTitle"]}" : Loc["StudentDashboard_PageTitle"])</PageTitle>

@* Ориентир страницы — предмет: его название и есть заголовок, без надзаголовка и описания. *@
<div class="fc-page-heading fc-journal-heading">
    <MudText Typo="Typo.h4">@(_selectedSubject?.Name ?? Loc["StudentDashboard_PageTitle"])</MudText>
    <div class="fc-journal-heading-actions">
        @if (_subjects.Count > 1)
        {
            <MudMenu Label="@Loc["StudentDashboard_SwitchSubject"]" Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.ArrowDropDown" Dense="true">
                @foreach (var subject in _subjects)
                {
                    <MudMenuItem OnClick="@(() => OnSubjectSelectedAsync(subject))" Icon="@(subject.Id == _selectedSubject?.Id ? Icons.Material.Filled.Check : null)">@subject.Name</MudMenuItem>
                }
            </MudMenu>
        }
        <MudButton Href="/student/logs" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.History">@Loc["MyLogs_PageTitle"]</MudButton>
    </div>
</div>

@if (_loading)
{
    <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_results is not null)
{
    @if (_mine is not null)
    {
        <StudentStatusCard Results="_mine" Queues="_queues" Rank="MyRow?.Rank" RankTotal="_results.UserResults.Count" OnJumpToRow="JumpToMyRowAsync" />
        @* Ближайшая очередь живая: архивированная или изменённая очередь перечитывается без перезагрузки страницы. *@
        <QueueListSubscription EventIds="_queues.Select(q => q.Id).ToList()" OnChanged="ReloadQueuesAsync" />
    }
    <SubjectResultsView @ref="_view" Results="_results" HighlightStudentId="_myId" OnResultUpdated="OnResultUpdatedAsync"
                        ShowRank="true" Heading="@Loc["Results_SheetTitle"]" PanelClass="fc-results-journal" />
}
else
{
    <div class="fc-panel fc-empty">@Loc["Design_ChooseSubject"]</div>
}
