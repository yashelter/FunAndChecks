@page "/student/queues"
@page "/student/queues/{EventId:int}"
@layout StudentLayout
@attribute [Authorize(Roles = Roles.Student)]
@implements IAsyncDisposable

<PageTitle>@Loc["StudentQueues_PageTitle"]</PageTitle>

<div class="fc-page-heading">
    <div>
        <span class="fc-eyebrow">@Loc["StudentQueues_PageTitle"]</span>
        <MudText Typo="Typo.h4">@(_details is null ? Loc["StudentQueues_Title"] : _details.EventName)</MudText>
        <p class="fc-muted">@(_details is null ? Loc["Design_QueueSubtitle"] : $"{_details.SubjectName} · {_details.EventDateTime.ToLocalTime():g}")</p>
    </div>
    @if (_details is null)
    {
        <MudSwitch T="bool" Value="_showPast" ValueChanged="OnShowPastChangedAsync" Color="Color.Primary">@Loc["Common_ShowPast"]</MudSwitch>
    }
    else
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToList">@Loc["StudentQueues_Title"]</MudButton>
    }
</div>

@if (_loading)
{
    <div class="fc-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_details is not null)
{
    <div class="fc-stats">
        <div class="fc-stat"><span>@Loc["Queue_StatusChecking"]</span><strong>@_participants.Count(p => p.Status == QueueEntryStatus.Checking)</strong></div>
        <div class="fc-stat"><span>@Loc["Queue_StatusWaiting"]</span><strong>@_participants.Count(p => p.Status == QueueEntryStatus.Waiting)</strong></div>
        <div class="fc-stat"><span>@Loc["Queue_StatusFinished"]</span><strong>@_participants.Count(p => p.Status == QueueEntryStatus.Finished)</strong></div>
    </div>
    <div class="fc-queue-note"><MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" /><span>@Loc["Design_QueueLive"]</span></div>
    @if (_participants.Any(p => p.Status == QueueEntryStatus.Checking && !string.IsNullOrWhiteSpace(p.CheckingByAdminName)))
    {
        <div class="fc-queue-note">
            <span>@Loc["Design_Reviewers"]:</span>
            <div class="fc-queue-reviewers">
                @foreach (var name in _participants.Where(p => p.Status == QueueEntryStatus.Checking).Select(p => p.CheckingByAdminName).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct())
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@name</MudChip>
                }
            </div>
        </div>
    }
    @if (MyEntry is { } mine)
    {
        <div class="fc-panel fc-queue-me">
            <div>
                <strong>@(MyPosition is int place ? Loc["StudentQueues_MyPlace", place, Waiting.Count] : QueueStyles.StatusText(mine.Status, mine.CheckingByAdminName, Loc))</strong>
                <small class="fc-muted">@Loc["StudentQueues_OrderHint"]</small>
            </div>
            @* Без самозаписи встать обратно нельзя — поэтому и выйти самому тоже. *@
            @if (_details.AllowSelfJoin && mine.Status is QueueEntryStatus.Skipped or QueueEntryStatus.Finished)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Replay" OnClick="RejoinAsync">@Loc["StudentQueues_Rejoin"]</MudButton>
            }
            @if (_details.AllowSelfJoin && mine.Status is QueueEntryStatus.Waiting or QueueEntryStatus.Skipped)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Logout" OnClick="LeaveAsync">@Loc["StudentQueues_Leave"]</MudButton>
            }
        </div>
    }
    <section class="fc-panel">
        <div class="fc-table-wrap">
            <table class="fc-queue-table">
                <thead><tr><th>#</th><th>@Loc["Results_ColName"]</th><th>@Loc["Results_ColGroup"]</th><th>@Loc["MyLogs_TotalPoints"]</th><th>@Loc["MyLogs_CurrentStatus"]</th></tr></thead>
                <tbody>
                    @foreach (var p in Ordered)
                    {
                        var place = Waiting.IndexOf(p);
                        var past = QueueStyles.IsPastRound(p, _participants);
                        <tr style="@QueueStyles.RowStyle(p.Status)" @key="p.EntryId" class="@(p.StudentId == _myId && !past ? "fc-queue-me-row" : "") @(past ? "fc-queue-past-round" : "")">
                            <td class="fc-queue-place">@(place >= 0 ? place + 1 : "")</td>
                            <td><UserChip UserId="p.StudentId" Name="@($"{p.LastName} {p.FirstName}")" NameClass="fc-result-name" NameStyle="@QueueStyles.NameStyle(p.StudentColor)" Compact="true" /></td>
                            <td class="fc-queue-group">@p.GroupName</td>
                            <td class="fc-queue-points">@p.TotalPoints</td>
                            <td class="fc-queue-status"><MudChip T="string" Color="@StatusColor(p.Status)" Size="Size.Small" Variant="Variant.Outlined">@QueueStyles.StatusText(p.Status, p.CheckingByAdminName, Loc)</MudChip>
                                @if (p.IsRejoin && !past) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="fc-queue-rejoin" title="@Loc["Queue_RoundHint", p.Round, p.JoinedAt.ToLocalTime().ToString("t")]">@Loc["Queue_RejoinBadge"]</MudChip> }
                                @if (past) { <small class="fc-muted fc-queue-round">@Loc["Queue_PastRound", p.Round]</small> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else
{
    <h3 class="fc-subsection-title">@Loc["StudentQueues_MyQueues"]</h3>
    @if (_myEvents.Count > 0)
    {
        <div class="fc-queue-events">
            @foreach (var ev in _myEvents)
            {
                <section class="fc-panel fc-queue-event" @key="ev.Id">
                    <div><MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" /><div><strong>@ev.Name</strong>
                        <small>@(ev.SubjectName is { } subject ? subject + " · " : "")@ev.EventDateTime.ToLocalTime().ToString("g")</small>
                        @if (ev.MyPosition is int place) { <small class="fc-queue-place-chip">@Loc["StudentQueues_MyPlace", place, ev.WaitingCount ?? place]</small> }
                        else if (ev.MyStatus is { } status) { <small class="fc-queue-place-chip">@QueueStyles.StatusText(status, null, Loc)</small> }
                    </div></div>
                    <div class="fc-toolbar"><MudButton Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => Open(ev.Id))">@Loc["Queues_Open"]</MudButton></div>
                </section>
            }
        </div>
    }
    else
    {
        <div class="fc-panel fc-empty">@Loc["StudentQueues_NoMyQueues"]</div>
    }

    <h3 class="fc-subsection-title">@Loc["StudentQueues_Available"]</h3>
    @if (_availableEvents.Count > 0)
    {
        <div class="fc-queue-events">
            @foreach (var ev in _availableEvents)
            {
                <section class="fc-panel fc-queue-event" @key="ev.Id">
                    <div><MudIcon Icon="@Icons.Material.Filled.EventNote" /><div><strong>@ev.Name</strong><small>@ev.EventDateTime.ToLocalTime().ToString("g")</small></div></div>
                    <div class="fc-toolbar">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Open(ev.Id))">@Loc["Queues_Open"]</MudButton>
                        @if (ev.AllowSelfJoin)
                        {
                            @* В хэллоуин-режиме вместо обычной иконки — тыква, нарисованная на CSS. *@
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => JoinAsync(ev.Id))" Class="@SignUpButtonClass" StartIcon="@SignUpButtonIcon">
                                @if (HalloweenActive)
                                {
                                    <span class="fc-pumpkin" aria-hidden="true"></span>
                                }
                                @Loc["StudentQueues_SignUp"]
                            </MudButton>
                        }
                    </div>
                </section>
            }
        </div>
    }
    else
    {
        <div class="fc-panel fc-empty">@Loc["StudentQueues_NoAvailable"]</div>
    }
}
