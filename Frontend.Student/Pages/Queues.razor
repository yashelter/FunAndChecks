@page "/student/queues"
@layout StudentLayout
@attribute [Authorize(Roles = Roles.Student)]
@implements IAsyncDisposable

<PageTitle>@Loc["StudentQueues_PageTitle"]</PageTitle>

<div class="d-flex justify-space-between align-center flex-wrap gap-2">
    <MudText Typo="Typo.h4" GutterBottom="true">@Loc["StudentQueues_Title"]</MudText>
    @if (_details is null)
    {
        <MudSwitch T="bool" Value="_showPast" ValueChanged="OnShowPastChangedAsync" Color="Color.Primary">@Loc["Common_ShowPast"]</MudSwitch>
    }
</div>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_details is not null)
{
    <div class="d-flex align-center mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="BackToList" Edge="Edge.Start" />
        <MudText Typo="Typo.h5" Class="ml-2">@Loc["StudentQueues_QueueTitle", _details.EventName]</MudText>
    </div>

    <MudList T="QueueParticipantDto" ReadOnly="true">
        @foreach (var p in _participants.OrderBy(x => QueueStyles.StatusOrder(x.Status)).ThenByDescending(x => x.TotalPoints))
        {
            <MudListItem T="QueueParticipantDto" Style="@QueueStyles.RowStyle(p.Status)">
                <div class="d-flex justify-space-between align-center flex-grow-1">
                    <span style="@QueueStyles.NameStyle(p.StudentColor)">@p.LastName @p.FirstName</span>
                    <div class="d-flex align-center gap-2">
                        <MudText Class="mr-2">@Loc["StudentQueues_Points", p.TotalPoints]</MudText>
                        <MudChip T="string" Color="@StatusColor(p.Status)" Size="Size.Small" Variant="Variant.Text">
                            @QueueStyles.StatusText(p.Status, p.CheckingByAdminName, Loc)
                        </MudChip>
                    </div>
                </div>
            </MudListItem>
            <MudDivider />
        }
    </MudList>
}
else
{
    <MudStack Spacing="4">
        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">@Loc["StudentQueues_MyQueues"]</MudText>
            @if (_myEvents.Count > 0)
            {
                <MudStack Spacing="2">
                    @foreach (var ev in _myEvents)
                    {
                        <MudPaper Class="pa-3 d-flex justify-space-between align-center" Outlined="true">
                            <div>
                                <MudText Typo="Typo.body1"><b>@ev.Name</b></MudText>
                                <MudText Typo="Typo.caption">@ev.EventDateTime.ToLocalTime().ToString("g")</MudText>
                            </div>
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       OnClick="@(() => ViewQueueAsync(ev.Id))">@Loc["Queues_Open"]</MudButton>
                        </MudPaper>
                    }
                </MudStack>
            }
            else
            {
                <MudText>@Loc["StudentQueues_NoMyQueues"]</MudText>
            }
        </div>

        <MudDivider />

        <div>
            <MudText Typo="Typo.h5" GutterBottom="true">@Loc["StudentQueues_Available"]</MudText>
            @if (_availableEvents.Count > 0)
            {
                <MudStack Spacing="2">
                    @foreach (var ev in _availableEvents)
                    {
                        <MudPaper Class="pa-3 d-flex justify-space-between align-center" Outlined="true">
                            <div>
                                <MudText Typo="Typo.body1"><b>@ev.Name</b></MudText>
                                <MudText Typo="Typo.caption">@ev.EventDateTime.ToLocalTime().ToString("g")</MudText>
                            </div>
                            <div class="d-flex gap-1">
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                           OnClick="@(() => ViewQueueAsync(ev.Id))">@Loc["Queues_Open"]</MudButton>
                                @if (ev.AllowSelfJoin)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               OnClick="@(() => JoinAsync(ev.Id))">@Loc["StudentQueues_SignUp"]</MudButton>
                                }
                            </div>
                        </MudPaper>
                    }
                </MudStack>
            }
            else
            {
                <MudText>@Loc["StudentQueues_NoAvailable"]</MudText>
            }
        </div>
    </MudStack>
}
