@page "/student/attendance"
@layout StudentLayout
@attribute [Authorize(Roles = Roles.Student)]

<PageTitle>Моя посещаемость</PageTitle>
<div class="attendance-page">
    <div class="attendance-heading"><div><span class="attendance-eyebrow">МОЯ ИСТОРИЯ</span><MudText Typo="Typo.h4">Посещаемость</MudText><MudText Typo="Typo.body2">Только занятия, на которых преподаватель ведёт учёт.</MudText></div></div>
    <MudPaper Class="attendance-panel" Elevation="0">
        <div class="attendance-toolbar">
            <MudSelect T="int?" Value="_subjectId" ValueChanged="ChangeSubjectAsync" ToStringFunc="@(id => _subjects.FirstOrDefault(s => s.Id == id)?.Name ?? "")" Label="Предмет" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_loading">
                @foreach (var subject in _subjects) { <MudSelectItem T="int?" Value="@subject.Id">@subject.Name</MudSelectItem> }
            </MudSelect>
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@(_loading || _subjectId is null)">Обновить</MudButton>
        </div>
    </MudPaper>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
    else if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    else if (_history.Count == 0)
    {
        <div class="attendance-empty"><MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" /><MudText Typo="Typo.h6">Пока нет отметок</MudText><MudText>Занятия без учёта посещаемости не считаются пропусками.</MudText></div>
    }
    else
    {
        <div class="attendance-stats">
            <div class="attendance-stat present"><span>Посещений</span><strong>@_history.Count(s => s.Status == AttendanceStatus.Present)</strong></div>
            <div class="attendance-stat absent"><span>Пропусков</span><strong>@_history.Count(s => s.Status == AttendanceStatus.Absent)</strong></div>
            <div class="attendance-stat unmarked"><span>Не отмечено</span><strong>@_history.Count(s => s.Status == AttendanceStatus.Unmarked)</strong></div>
        </div>
        <MudPaper Class="attendance-panel" Elevation="0">
            @foreach (var entry in _history)
            {
                <div class="attendance-history-row"><span class="@AttendanceStyles.Css(entry.Status)">@AttendanceStyles.Symbol(entry.Status)</span><div><strong>@entry.Name</strong><small class="attendance-group">@AttendanceStyles.Moscow(entry.StartsAt).ToString("dd.MM.yyyy HH:mm") · Москва · @AttendanceStyles.Text(entry.Status)</small>
                    @if (entry.UpdatedAt.HasValue) { <small class="attendance-group">@(entry.MarkedBy ?? "Преподаватель удалён") · отметка обновлена @AttendanceStyles.Moscow(entry.UpdatedAt.Value).ToString("dd.MM.yyyy HH:mm")</small> }
                </div></div>
            }
        </MudPaper>
    }
</div>
