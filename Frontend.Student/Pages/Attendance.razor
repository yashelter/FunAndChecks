@page "/student/attendance"
@layout StudentLayout
@attribute [Authorize(Roles = Roles.Student)]

<PageTitle>@Loc["MyAttendance_PageTitle"]</PageTitle>
<div class="attendance-page fc-student-attendance">
    <div class="fc-page-heading"><div><span class="fc-eyebrow">@Loc["MyAttendance_Eyebrow"]</span><MudText Typo="Typo.h4">@Loc["Nav_Attendance"]</MudText><p class="fc-muted">@Loc["MyAttendance_Subtitle"]</p></div></div>
    <section class="fc-panel fc-subject-filter">
        <div class="fc-panel-body fc-toolbar">
            <MudSelect T="int?" Value="_subjectId" ValueChanged="ChangeSubjectAsync" ToStringFunc="@(id => _subjects.FirstOrDefault(s => s.Id == id)?.Name ?? "")" Label="@Loc["Common_Subject"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_loading">
                @foreach (var subject in _subjects) { <MudSelectItem T="int?" Value="@subject.Id">@subject.Name</MudSelectItem> }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@(_loading || _subjectId is null)">@Loc["Attendance_Refresh"]</MudButton>
        </div>
    </section>
    @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
    else if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    else if (_history.Count == 0)
    {
        <div class="attendance-empty"><MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" /><MudText Typo="Typo.h6">@Loc["MyAttendance_Empty"]</MudText><MudText>@Loc["MyAttendance_EmptyHint"]</MudText></div>
    }
    else
    {
        <div class="fc-stats">
            <div class="fc-stat present"><span>@Loc["AttendanceJournal_PresentCount"]</span><strong>@_history.Count(s => s.Status == AttendanceStatus.Present)</strong></div>
            <div class="fc-stat absent"><span>@Loc["AttendanceJournal_AbsentCount"]</span><strong>@_history.Count(s => s.Status == AttendanceStatus.Absent)</strong></div>
            <div class="fc-stat unmarked"><span>@Loc["AttendanceJournal_UnmarkedCount"]</span><strong>@_history.Count(s => s.Status == AttendanceStatus.Unmarked)</strong></div>
        </div>
        <section class="fc-panel">
            <div class="fc-panel-heading"><h3>@Loc["MyAttendance_History"]</h3><small class="fc-muted">@Loc["Attendance_MoscowTime"] · UTC+3</small></div>
            @foreach (var entry in _history)
            {
                <div class="attendance-history-row"><span class="@AttendanceStyles.Css(entry.Status)">@AttendanceStyles.Symbol(entry.Status)</span><div><strong>@entry.Name</strong><small class="attendance-group">@AttendanceStyles.Moscow(entry.StartsAt).ToString("dd.MM.yyyy HH:mm") · @Loc["Attendance_MoscowTime"] · @AttendanceStyles.Text(entry.Status)</small>
                    @if (entry.UpdatedAt.HasValue) { <small class="attendance-group">@(entry.MarkedBy ?? Loc["Attendance_TeacherDeleted"]) · @Loc["MyAttendance_Updated"] @AttendanceStyles.Moscow(entry.UpdatedAt.Value).ToString("dd.MM.yyyy HH:mm")</small> }
                </div></div>
            }
        </section>
    }
</div>
